# ==============================================================
# Influx Financial — environment variables
# Copy to `.env` for local development. Set production values in
# Cloudflare Pages → Settings → Environment variables.
# NEVER commit real values to source control.
# ==============================================================

# --- Cloudflare Turnstile (spam protection for forms) ---
# Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile
# The SITE key is public (rendered in the browser); the SECRET key
# is server-side only and used by functions/api/contact.ts.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Form delivery ---
# Email address that receives enquiry notifications.
CONTACT_INBOX=jose@influxfinancial.com.au

# Optional: Resend API key (https://resend.com) used by the contact
# Pages Function to deliver enquiry emails. If unset, submissions are
# logged but not emailed — configure before launch.
RESEND_API_KEY=

# Sender address for notification emails. Must be a domain verified
# with your email provider (e.g. no-reply@influxfinancial.com.au).
CONTACT_FROM=

# --- Analytics (optional) ---
# [OWNER TO CONFIRM: analytics platform — e.g. Cloudflare Web Analytics
# token or GA4 measurement ID]
PUBLIC_ANALYTICS_ID=
