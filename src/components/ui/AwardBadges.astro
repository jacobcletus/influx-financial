---
/**
 * AFG Broker Awards 2026 finalist seals — two circular badges.
 * `imgClass` sets size (+ any ring) per context; `gap` sets spacing;
 * `class` sets alignment/margins (e.g. justify-center or justify-start).
 */
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'div'> {
  imgClass?: string;
  gap?: string;
}
const { imgClass = 'h-16 w-16', gap = 'gap-4', class: className = '', ...rest } = Astro.props;
const base = 'shrink-0 rounded-full object-cover shadow-[0_8px_24px_rgba(0,0,0,0.3)]';
---

<div {...rest} class:list={['flex items-center', gap, className]}>
  <img
    src="/images/badges/badge-1.webp"
    alt="Finalist, AFG Broker Awards 2026 — Best New Broker Award"
    width="240"
    height="240"
    loading="lazy"
    class:list={[base, imgClass]}
  />
  <img
    src="/images/badges/badge-2.webp"
    alt="Finalist, AFG Broker Awards 2026 — Best New Mortgage Group Award"
    width="240"
    height="240"
    loading="lazy"
    class:list={[base, imgClass]}
  />
</div>
