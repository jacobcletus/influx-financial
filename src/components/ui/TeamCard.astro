---
interface Props {
  name: string;
  role: string;
  image: string;
  imageAlt: string;
  bio?: string;
  focus?: string[];
  delay?: number;
}
const { name, role, image, imageAlt, bio, focus = [], delay = 0 } = Astro.props;
/** Strip inline [OWNER TO CONFIRM] notes from public display copy. */
const publicBio = bio?.replace(/\s*\[OWNER TO CONFIRM:[^\]]*\]\s*/g, ' ').trim();
---

<article
  class="group overflow-hidden rounded-2xl border border-line-100 bg-white shadow-card"
  data-reveal
  style={delay ? `--reveal-delay: ${delay}ms` : undefined}
>
  <div class="overflow-hidden bg-mist-100">
    <img
      src={image}
      alt={imageAlt}
      width="400"
      height="400"
      loading="lazy"
      class="aspect-square w-full object-cover transition-transform duration-500 motion-safe:group-hover:scale-[1.03]"
    />
  </div>
  <div class="p-6">
    <h3 class="text-xl font-bold text-ink-950">{name}</h3>
    <p class="mt-0.5 text-[0.9rem] font-semibold text-pine-700">{role}</p>
    {publicBio && <p class="mt-3 text-[0.92rem] leading-relaxed text-ink-600">{publicBio}</p>}
    {
      focus.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-1.5">
          {focus.map((f) => (
            <li class="rounded-full bg-mist-100 px-3 py-1 text-[0.78rem] font-medium text-pine-800">
              {f}
            </li>
          ))}
        </ul>
      )
    }
  </div>
</article>
