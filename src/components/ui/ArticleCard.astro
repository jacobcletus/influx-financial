---
import { formatDate } from '@/utils/format';

interface Props {
  title: string;
  description: string;
  href: string;
  category: string;
  publishDate: Date;
  delay?: number;
}
const { title, description, href, category, publishDate, delay = 0 } = Astro.props;
---

<a
  href={href}
  class="group flex flex-col rounded-2xl border border-line-100 bg-white p-6 shadow-card transition-all duration-300 hover:border-sage-200 hover:shadow-card-hover motion-safe:hover:-translate-y-0.5"
  data-reveal
  style={delay ? `--reveal-delay: ${delay}ms` : undefined}
>
  <div class="mb-3 flex items-center gap-3 text-[0.78rem] font-semibold">
    <span class="rounded-full bg-mist-100 px-3 py-1 text-pine-800">{category}</span>
    <time datetime={publishDate.toISOString()} class="text-ink-500">
      {formatDate(publishDate)}
    </time>
  </div>
  <h3 class="text-lg font-bold leading-snug text-ink-950 group-hover:text-pine-800">{title}</h3>
  <p class="mt-2 flex-1 text-[0.92rem] leading-relaxed text-ink-600">{description}</p>
  <span class="mt-4 text-[0.88rem] font-semibold text-pine-700">Read article →</span>
</a>
