---
import Icon from '@/components/ui/Icon.astro';

interface Props {
  title: string;
  description: string;
  href: string;
  icon: string;
  delay?: number;
}
const { title, description, href, icon, delay = 0 } = Astro.props;
---

<a
  href={href}
  class="spotlight-card group flex flex-col rounded-2xl border border-line-100 bg-white p-7 shadow-card transition-all duration-300 hover:border-sage-200 hover:shadow-card-hover motion-safe:hover:-translate-y-0.5"
  data-reveal
  style={delay ? `--reveal-delay: ${delay}ms` : undefined}
>
  <span
    class="mb-5 flex h-12 w-12 items-center justify-center rounded-full border border-sage-200/80 bg-white text-pine-700 transition-colors duration-300 group-hover:border-pine-800 group-hover:bg-pine-800 group-hover:text-white"
  >
    <Icon name={icon} size={21} />
  </span>
  <h3 class="text-[1.12rem] font-bold text-ink-950 group-hover:text-pine-800">{title}</h3>
  <p class="mt-2 flex-1 text-[0.92rem] leading-relaxed text-ink-600">{description}</p>
  <span
    class="mt-5 inline-flex items-center gap-1.5 border-t border-line-100 pt-4 text-[0.82rem] font-semibold uppercase tracking-[0.1em] text-pine-700"
  >
    Learn more
    <Icon
      name="arrow-right"
      size={15}
      class="transition-transform duration-200 motion-safe:group-hover:translate-x-0.5"
    />
  </span>
</a>
