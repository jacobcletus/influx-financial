---
import Icon from '@/components/ui/Icon.astro';

interface Props {
  title: string;
  description: string;
  href: string;
  icon: string;
  delay?: number;
}
const { title, description, href, icon, delay = 0 } = Astro.props;
---

<a
  href={href}
  class="spotlight-card group flex flex-col rounded-2xl border border-line-100 bg-white p-6 shadow-card transition-all duration-300 hover:border-sage-200 hover:shadow-card-hover motion-safe:hover:-translate-y-0.5"
  data-reveal
  style={delay ? `--reveal-delay: ${delay}ms` : undefined}
>
  <span
    class="mb-4 flex h-11 w-11 items-center justify-center rounded-xl bg-mist-100 text-pine-700 transition-colors group-hover:bg-pine-700 group-hover:text-white"
  >
    <Icon name={icon} size={22} />
  </span>
  <h3 class="text-lg font-bold text-ink-950 group-hover:text-pine-800">{title}</h3>
  <p class="mt-1.5 flex-1 text-[0.92rem] leading-relaxed text-ink-600">{description}</p>
  <span class="mt-4 inline-flex items-center gap-1.5 text-[0.88rem] font-semibold text-pine-700">
    Learn more
    <Icon
      name="arrow-right"
      size={15}
      class="transition-transform duration-200 motion-safe:group-hover:translate-x-0.5"
    />
  </span>
</a>
