---
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import { site } from '@/data/site';

interface Props {
  heading?: string;
  body?: string;
}
const {
  heading = 'Talk to us before you talk to a lender',
  body = 'A free 30-minute consultation, tax and mortgage questions welcome. No obligation, no pressure, and you leave with a clear next step.',
} = Astro.props;
---

<section class="bg-glow-dark on-dark bg-pine-950">
  <div class="container-site py-24 text-center sm:py-28">
    <div class="mx-auto max-w-2xl" data-reveal>
      <h2
        class="text-[2.1rem] font-extrabold uppercase leading-[1.02] tracking-[-0.015em] text-white sm:text-5xl lg:text-[3.4rem]"
      >
        {heading}
      </h2>
      <p class="mt-6 text-lg leading-relaxed text-sage-200">{body}</p>
      <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <Button href="/book-consultation" variant="gold" size="lg">
          Book a Free Consultation
        </Button>
        <a
          href={site.contact.phoneHref}
          class="inline-flex items-center gap-2 rounded-full border border-white/25 px-7 py-3.5 text-base font-semibold text-white transition-colors hover:bg-white/10"
        >
          <Icon name="phone" size={18} />
          {site.contact.phone}
        </a>
      </div>
      <p class="mt-5 text-sm text-sage-400">
        Or <a href="/contact" class="underline underline-offset-2 hover:text-white"
          >send an enquiry</a
        > and we'll call you back.
      </p>
    </div>
  </div>
</section>
