---
/**
 * Trust bar under the hero. Only statistics present in
 * src/data/site.ts are shown; figures pending owner verification are
 * marked in that file. Lender logos are intentionally NOT displayed
 * until Influx confirms permission from each lender.
 */
import StatCounter from '@/components/animations/StatCounter';
import DuoStat from '@/components/animations/DuoStat';
import { site } from '@/data/site';
---

<section class="border-b border-line-100 bg-white" aria-label="About Influx at a glance">
  <div class="container-site py-14">
    <div
      class="grid grid-cols-1 items-center gap-10 divide-line-100 sm:grid-cols-3 sm:gap-0 sm:divide-x"
    >
      {
        site.stats.map((stat) => (
          <StatCounter client:visible value={stat.value} suffix={stat.suffix} label={stat.label} />
        ))
      }
      <DuoStat client:visible label="broking + accounting, one roof" />
    </div>
    <p class="mt-10 border-t border-line-100 pt-5 text-center text-xs text-ink-500">
      Figures based on Influx Financial client and lender-panel records.
    </p>
  </div>
</section>
