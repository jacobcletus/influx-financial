---
/** Numbered step-by-step process with staggered reveal. */
interface Props {
  steps: Array<{ title: string; body: string }>;
  class?: string;
}
const { steps, class: className = '' } = Astro.props;
---

<ol class={`relative space-y-0 ${className}`}>
  {
    steps.map((step, i) => (
      <li
        class="relative flex gap-5 pb-8 last:pb-0 sm:gap-6"
        data-reveal
        style={`--reveal-delay: ${i * 70}ms`}
      >
        {i < steps.length - 1 && (
          <span
            aria-hidden="true"
            class="absolute left-[21px] top-12 h-[calc(100%-2.5rem)] w-px bg-line-200 sm:left-[23px]"
          />
        )}
        <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-sage-200 bg-white text-[0.95rem] font-bold text-pine-800 shadow-card sm:h-12 sm:w-12">
          {i + 1}
        </span>
        <div class="pt-1.5">
          <h3 class="text-lg font-bold text-ink-950">{step.title}</h3>
          <p class="mt-1 max-w-xl leading-relaxed text-ink-600">{step.body}</p>
        </div>
      </li>
    ))
  }
</ol>
