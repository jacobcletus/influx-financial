---
interface Props {
  eyebrow?: string;
  heading: string;
  lede?: string;
  align?: 'left' | 'center';
  dark?: boolean;
  /** Heading level — use "h1" when this is the page's main heading. */
  as?: 'h1' | 'h2';
  class?: string;
}
const {
  eyebrow,
  heading,
  lede,
  align = 'left',
  dark = false,
  as: Heading = 'h2',
  class: className = '',
}: Props = Astro.props;
---

<div
  class={`max-w-2xl ${align === 'center' ? 'mx-auto text-center' : ''} ${className}`}
  data-reveal
>
  {
    eyebrow && (
      <p
        class={`mb-3 text-[0.8rem] font-bold uppercase tracking-[0.14em] ${dark ? 'text-sage-300' : 'text-pine-700'}`}
      >
        {eyebrow}
      </p>
    )
  }
  <Heading class={`text-3xl sm:text-4xl ${dark ? 'text-white' : ''}`}>
    {heading}
  </Heading>
  {
    lede && (
      <p class={`mt-4 text-lg leading-relaxed ${dark ? 'text-sage-200' : 'text-ink-600'}`}>
        {lede}
      </p>
    )
  }
</div>
