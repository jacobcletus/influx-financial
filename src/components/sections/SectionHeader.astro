---
interface Props {
  eyebrow?: string;
  heading: string;
  lede?: string;
  align?: 'left' | 'center';
  dark?: boolean;
  /** Heading level, use "h1" when this is the page's main heading. */
  as?: 'h1' | 'h2';
  class?: string;
}
const {
  eyebrow,
  heading,
  lede,
  align = 'left',
  dark = false,
  as: Heading = 'h2',
  class: className = '',
}: Props = Astro.props;
---

<div
  class={`max-w-3xl ${align === 'center' ? 'mx-auto text-center' : ''} ${className}`}
  data-reveal
>
  {
    eyebrow && (
      <p
        class={`eyebrow mb-5 rounded-full border px-3.5 py-1.5 ${dark ? 'border-white/15 bg-white/[0.07] text-sage-300' : 'border-pine-800/15 bg-white text-pine-700'}`}
      >
        {eyebrow}
      </p>
    )
  }
  <Heading
    class={`text-[2.1rem] font-extrabold sm:text-[2.6rem] lg:text-[2.9rem] ${dark ? 'text-white' : ''}`}
  >
    {heading}
  </Heading>
  {
    lede && (
      <p class={`mt-5 text-lg leading-relaxed ${dark ? 'text-sage-200' : 'text-ink-600'}`}>
        {lede}
      </p>
    )
  }
</div>
