---
import { site } from '@/data/site';
import Icon from '@/components/ui/Icon.astro';
import AwardBadges from '@/components/ui/AwardBadges.astro';

const year = new Date().getFullYear();

const explore = [
  { label: 'Services', href: '/services' },
  { label: 'First Home Buyers', href: '/services/first-home-buyers' },
  { label: 'Refinancing', href: '/services/refinancing' },
  { label: 'Why Influx', href: '/why-influx' },
  { label: 'Resources', href: '/resources' },
  { label: 'About', href: '/about' },
];

const legal = [
  { label: 'Privacy Policy', href: '/privacy-policy' },
  { label: 'Terms of Use', href: '/terms' },
  { label: 'Disclaimer', href: '/disclaimer' },
];

const finalist = site.awards.filter((a) => a.result === 'Finalist');
---

<footer class="on-dark bg-glow-dark relative isolate overflow-hidden bg-pine-950 text-sage-200">
  <!-- Oversized brand wordmark, low-opacity, seated flush at the bottom -->
  <span
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 -bottom-3 select-none text-center font-display text-[19vw] font-extrabold uppercase leading-none tracking-[-0.05em] text-white/[0.045] sm:-bottom-5"
  >
    Influx
  </span>

  <div class="container-site relative py-20 sm:py-24">
    <!-- Detail row -->
    <div class="grid gap-12 lg:grid-cols-[1.5fr_1fr_1.1fr]">
      <!-- Brand + recognition + social -->
      <div>
        <img
          src="/images/influx-logo-white.png"
          alt="Influx Financial"
          width="1859"
          height="242"
          class="h-8 w-auto"
          loading="lazy"
        />
        <p class="mt-6 max-w-xs text-[0.95rem] leading-relaxed text-sage-300">
          Mortgage broking, lending and accounting for {site.contact.serviceArea}.
        </p>
        {
          finalist.length > 0 && (
            <AwardBadges
              imgClass="h-16 w-16 ring-1 ring-white/10 sm:h-20 sm:w-20"
              gap="gap-4"
              class="mt-7 justify-start"
            />
          )
        }
        <div class="mt-7 flex gap-3">
          {
            site.social.facebook && (
              <a
                href={site.social.facebook}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Influx Financial on Facebook"
                class="flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20"
              >
                <Icon name="facebook" size={18} />
              </a>
            )
          }
          {
            site.social.instagram && (
              <a
                href={site.social.instagram}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Influx Financial on Instagram"
                class="flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20"
              >
                <Icon name="instagram" size={18} />
              </a>
            )
          }
        </div>
      </div>

      <!-- Explore -->
      <nav aria-label="Footer navigation">
        <p class="eyebrow eyebrow-rule mb-5 text-sage-400">Explore</p>
        <ul class="space-y-2.5 text-[0.95rem]">
          {
            explore.map((link) => (
              <li>
                <a href={link.href} class="text-sage-100 transition-colors hover:text-white">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Offices + contact -->
      <div>
        <p class="eyebrow eyebrow-rule mb-5 text-sage-400">
          {site.offices.length > 1 ? 'Offices' : 'Office'}
        </p>
        <ul class="space-y-4 text-[0.9rem] text-sage-300">
          {
            site.offices.map((office) => (
              <li>
                <span class="block font-semibold text-white">{office.locality}</span>
                <span class="block">{office.address}</span>
                <a
                  href={office.phoneHref}
                  class="font-medium text-sage-200 transition-colors hover:text-gold-200"
                >
                  {office.phone}
                </a>
              </li>
            ))
          }
          <li>
            <a
              href={site.contact.emailHref}
              class="break-all font-medium text-white transition-colors hover:text-gold-200"
            >
              {site.contact.email}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Legal strip -->
    <div
      class="mt-16 flex flex-col gap-4 border-t border-white/12 pt-8 sm:flex-row sm:items-center sm:justify-between"
    >
      <nav aria-label="Legal" class="flex flex-wrap items-center gap-x-6 gap-y-2 text-[0.85rem]">
        {
          legal.map((link) => (
            <a href={link.href} class="text-sage-300 transition-colors hover:text-white">
              {link.label}
            </a>
          ))
        }
      </nav>
      <p class="text-[0.82rem] text-sage-400">© {year} {site.name}. All rights reserved.</p>
    </div>

    <p class="mt-6 max-w-4xl text-[0.78rem] leading-relaxed text-sage-400">
      {site.legalName} (ABN {site.regulatory.abn}). Credit services are provided by {
        site.regulatory.creditRepName
      }, Australian Credit Representative {site.regulatory.creditRepNumber}, under Australian Credit
      Licence {site.regulatory.acl} ({site.regulatory.aclHolder}). Accounting and tax services are
      provided by OneHQ Accounting. Information here is general only and does not consider your
      objectives, financial situation or needs.
    </p>
  </div>
</footer>
