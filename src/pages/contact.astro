---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/navigation/Breadcrumbs.astro';
import Icon from '@/components/ui/Icon.astro';
import ContactForm from '@/components/forms/ContactForm';
import { site } from '@/data/site';

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined;
const headOffice = site.offices[0];
---

<BaseLayout
  title="Contact Influx Financial, Melbourne Mortgage Brokers"
  description="Call 0488 705 689, email admin@influxfinancial.com.au, or visit our Mickleham or Croydon offices. Phone and video appointments available Australia-wide."
>
  <!-- ============ HERO WITH FORM ============ -->
  <section class="bg-glow-dark on-dark bg-pine-950">
    <div
      class="container-site grid items-start gap-12 py-16 sm:py-20 lg:grid-cols-[1fr_0.92fr] lg:py-24"
    >
      <div>
        <Breadcrumbs items={[{ name: 'Contact', href: '/contact' }]} class="mb-8 text-sage-300" />
        <p
          class="eyebrow mb-6 rounded-full border border-white/15 bg-white/[0.07] px-3.5 py-1.5 text-sage-300"
          data-reveal
        >
          Contact
        </p>
        <h1
          class="max-w-xl text-[2.2rem] font-extrabold uppercase leading-[1.02] tracking-[-0.02em] text-white sm:text-5xl lg:text-[3.2rem]"
        >
          Talk to a person, not a portal
        </h1>
        <p
          class="mt-6 max-w-lg text-lg leading-relaxed text-sage-200"
          data-reveal
          style="--reveal-delay: 200ms"
        >
          Call, email, visit an office or send the form, enquiries are answered within one business
          day.
        </p>
        <a
          href={site.contact.phoneHref}
          class="font-display mt-9 inline-flex items-center gap-4 text-[2rem] font-extrabold tracking-[-0.02em] text-white transition-colors hover:text-gold-200 sm:text-[2.6rem]"
          data-reveal
          style="--reveal-delay: 300ms"
        >
          <span
            class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full border border-white/20 bg-white/[0.07] text-gold-200"
          >
            <Icon name="phone" size={24} />
          </span>
          {site.contact.phone}
        </a>
        <p
          class="mt-6 flex max-w-lg flex-wrap gap-x-6 gap-y-2 border-t border-white/15 pt-6 text-[0.9rem] font-medium text-sage-200"
          data-reveal
          style="--reveal-delay: 400ms"
        >
          <a
            href={site.contact.emailHref}
            class="flex items-center gap-2 transition-colors hover:text-white"
          >
            <Icon name="mail" size={15} class="text-gold-200" />
            {site.contact.email}
          </a>
          <span class="flex items-center gap-2">
            <Icon name="map" size={15} class="text-gold-200" /> Mickleham &amp; Croydon offices
          </span>
        </p>
      </div>

      <div
        class="rounded-[1.75rem] bg-white p-6 shadow-card-hover sm:p-9"
        data-reveal
        style="--reveal-delay: 250ms"
      >
        <p class="eyebrow eyebrow-rule mb-4 text-pine-700">Send an enquiry</p>
        <h2 class="text-[1.6rem] font-extrabold text-ink-950 sm:text-[1.9rem]">
          We'll come back within a day
        </h2>
        <p class="mb-7 mt-2 text-[0.92rem] text-ink-600">
          Short and simple. Please don't include sensitive details like tax file numbers or account
          numbers.
        </p>
        <ContactForm client:visible turnstileSiteKey={turnstileSiteKey} />
      </div>
    </div>
  </section>

  <!-- ============ OFFICES ============ -->
  <section class="bg-texture bg-mist-50">
    <div class="container-site py-24 sm:py-28">
      <div class="max-w-3xl" data-reveal>
        <p class="eyebrow eyebrow-rule mb-4 text-pine-700">Our offices</p>
        <h2 class="text-[2rem] font-extrabold sm:text-[2.5rem]">Two Melbourne offices, one team</h2>
        <p class="mt-5 text-lg leading-relaxed text-ink-600">
          Drop in to Mickleham or Croydon, or book a phone or video appointment from anywhere in
          Australia.
        </p>
      </div>

      <div class="mt-12 grid gap-6 lg:grid-cols-2">
        {
          site.offices.map((office, i) => (
            <div
              class="overflow-hidden rounded-[1.5rem] border border-line-100 bg-white shadow-card"
              data-reveal
              style={`--reveal-delay: ${i * 100}ms`}
            >
              <iframe
                title={`Map of the ${office.name} office`}
                src={`https://maps.google.com/maps?q=${encodeURIComponent(office.mapQuery)}&z=15&output=embed`}
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                class="h-56 w-full border-0"
              />
              <div class="p-7 sm:p-8">
                <div class="flex items-center gap-3">
                  <span class="font-display text-sm font-bold tracking-[0.12em] text-sage-400">
                    0{i + 1}
                  </span>
                  <h3 class="text-xl font-extrabold text-ink-950">{office.name}</h3>
                </div>
                <address class="mt-4 space-y-3 not-italic">
                  <p class="flex items-start gap-3 text-ink-700">
                    <Icon name="map" size={19} class="mt-0.5 shrink-0 text-pine-700" />
                    <span>
                      {office.building && (
                        <span class="block font-semibold text-ink-950">{office.building}</span>
                      )}
                      {office.address}
                      <br />
                      {office.suburb}
                    </span>
                  </p>
                  <a
                    href={office.phoneHref}
                    class="flex items-center gap-3 font-semibold text-ink-950 transition-colors hover:text-pine-700"
                  >
                    <Icon name="phone" size={19} class="shrink-0 text-pine-700" />
                    {office.phone}
                  </a>
                </address>
                <a
                  href={`https://maps.google.com/maps?q=${encodeURIComponent(office.mapQuery)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-6 inline-flex items-center gap-1.5 border-t border-line-100 pt-5 text-[0.82rem] font-semibold uppercase tracking-[0.1em] text-pine-700"
                >
                  Get directions
                  <Icon name="arrow-right" size={15} />
                </a>
              </div>
            </div>
          ))
        }
      </div>

      <!-- Other ways in -->
      <div class="mt-6 grid gap-6 sm:grid-cols-3">
        <a
          href={site.contact.phoneHref}
          class="flex items-center gap-4 rounded-2xl border border-line-100 bg-white p-6 shadow-card transition-all hover:border-sage-200 hover:shadow-card-hover"
          data-reveal
        >
          <span
            class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-sage-200/80 bg-white text-pine-700"
          >
            <Icon name="phone" size={22} />
          </span>
          <span>
            <span class="block text-[0.72rem] font-semibold uppercase tracking-[0.14em] text-ink-500">
              Call us
            </span>
            <span class="font-display mt-0.5 block text-lg font-extrabold text-ink-950">
              {site.contact.phone}
            </span>
          </span>
        </a>
        <a
          href={site.contact.emailHref}
          class="flex items-center gap-4 rounded-2xl border border-line-100 bg-white p-6 shadow-card transition-all hover:border-sage-200 hover:shadow-card-hover"
          data-reveal
          style="--reveal-delay: 80ms"
        >
          <span
            class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-sage-200/80 bg-white text-pine-700"
          >
            <Icon name="mail" size={22} />
          </span>
          <span class="min-w-0">
            <span class="block text-[0.72rem] font-semibold uppercase tracking-[0.14em] text-ink-500">
              Email us
            </span>
            <span class="mt-0.5 block break-all text-[0.95rem] font-bold text-ink-950">
              {site.contact.email}
            </span>
          </span>
        </a>
        <div
          class="bg-glow-dark flex flex-col justify-center rounded-2xl bg-pine-950 p-6"
          data-reveal
          style="--reveal-delay: 160ms"
        >
          <p class="font-display text-base font-extrabold uppercase tracking-[-0.01em] text-white">
            Prefer a scheduled time?
          </p>
          <a
            href="/book-consultation"
            class="mt-4 inline-block self-start rounded-full bg-gold-400 px-5 py-2.5 text-[0.9rem] font-semibold text-pine-950 shadow-btn transition-colors hover:bg-gold-200"
          >
            Book a Free Consultation
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
