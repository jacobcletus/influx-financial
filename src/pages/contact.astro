---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/navigation/Breadcrumbs.astro';
import Icon from '@/components/ui/Icon.astro';
import ContactForm from '@/components/forms/ContactForm';
import { site } from '@/data/site';

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined;
---

<BaseLayout
  title="Contact Influx Financial — Melbourne Mortgage Brokers"
  description="Call 03 7047 9370, email admin@influxfinancial.com.au, or send an enquiry. Melbourne-based, with phone and video appointments across Australia."
>
  <section class="bg-mist-50 bg-texture">
    <div class="container-site py-14 sm:py-16">
      <Breadcrumbs items={[{ name: 'Contact', href: '/contact' }]} class="mb-6 text-ink-500" />
      <div class="max-w-3xl">
        <p class="mb-3 text-[0.8rem] font-bold uppercase tracking-[0.14em] text-pine-700">
          Contact
        </p>
        <h1 class="text-3xl sm:text-4xl lg:text-[2.75rem]">Talk to a person, not a portal</h1>
        <p class="mt-5 text-lg leading-relaxed text-ink-600">
          Call, email or send the form — enquiries are answered within one business day.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="container-site grid gap-12 py-16 sm:py-20 lg:grid-cols-[0.85fr_1.15fr]">
      <div class="space-y-5">
        <a
          href={site.contact.phoneHref}
          class="flex items-center gap-4 rounded-2xl border border-line-100 bg-white p-6 shadow-card transition-all hover:border-sage-200 hover:shadow-card-hover"
        >
          <span
            class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-mist-100 text-pine-700"
          >
            <Icon name="phone" size={24} />
          </span>
          <span>
            <span class="block text-sm font-semibold text-ink-500">Call us</span>
            <span class="block text-lg font-bold text-ink-950">{site.contact.phone}</span>
          </span>
        </a>
        <a
          href={site.contact.emailHref}
          class="flex items-center gap-4 rounded-2xl border border-line-100 bg-white p-6 shadow-card transition-all hover:border-sage-200 hover:shadow-card-hover"
        >
          <span
            class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-mist-100 text-pine-700"
          >
            <Icon name="mail" size={24} />
          </span>
          <span>
            <span class="block text-sm font-semibold text-ink-500">Email us</span>
            <span class="block break-all text-lg font-bold text-ink-950">{site.contact.email}</span>
          </span>
        </a>
        <div
          class="flex items-center gap-4 rounded-2xl border border-line-100 bg-white p-6 shadow-card"
        >
          <span
            class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-mist-100 text-pine-700"
          >
            <Icon name="map" size={24} />
          </span>
          <span>
            <span class="block text-sm font-semibold text-ink-500">Where we work</span>
            <span class="block text-[1.02rem] font-bold text-ink-950">
              Melbourne &amp; across Victoria
            </span>
            <span class="block text-[0.85rem] text-ink-600">
              Phone and video appointments Australia-wide
              <!-- [OWNER TO CONFIRM: public office address and hours; embedded map added once confirmed] -->
            </span>
          </span>
        </div>
        <div class="rounded-2xl bg-pine-950 p-6 text-white">
          <p class="font-bold">Prefer a scheduled time?</p>
          <p class="mt-1 text-[0.92rem] text-sage-200">
            Book a free 30-minute consultation and we'll call you.
          </p>
          <a
            href="/book-consultation"
            class="mt-4 inline-block rounded-full bg-white px-5 py-2.5 text-[0.92rem] font-semibold text-pine-900 transition-colors hover:bg-mist-100"
          >
            Book a Free Consultation
          </a>
        </div>
      </div>

      <div class="rounded-3xl border border-line-100 bg-mist-50 p-6 sm:p-9">
        <h2 class="text-2xl font-bold">Send an enquiry</h2>
        <p class="mb-7 mt-1.5 text-[0.92rem] text-ink-600">
          Short and simple — we'll come back to you within one business day. Please don't include
          sensitive details like tax file numbers or account numbers.
        </p>
        <ContactForm client:visible turnstileSiteKey={turnstileSiteKey} />
      </div>
    </div>
  </section>
</BaseLayout>
