---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
---

<BaseLayout
  title="Page Not Found | Influx Financial"
  description="That page doesn't exist or has moved. Head back to the Influx Financial homepage or browse our services."
  noindex
>
  <section class="bg-mist-50 bg-texture">
    <div
      class="container-site flex min-h-[55vh] flex-col items-center justify-center py-20 text-center"
    >
      <p class="text-[0.8rem] font-bold uppercase tracking-[0.14em] text-pine-700">404</p>
      <h1 class="mt-3 max-w-xl text-3xl sm:text-4xl">
        This page has moved out, no forwarding address
      </h1>
      <p class="mt-4 max-w-md text-lg text-ink-600">
        The link may be old or mistyped. Everything worth finding is one click away:
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <Button href="/">
          Back to home
          <Icon name="arrow-right" size={16} />
        </Button>
        <Button href="/services" variant="secondary">Browse services</Button>
        <Button href="/contact" variant="secondary">Contact us</Button>
      </div>
    </div>
  </section>
</BaseLayout>
