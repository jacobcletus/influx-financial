---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/navigation/Breadcrumbs.astro';
import ArticleCard from '@/components/ui/ArticleCard.astro';
import ConsultationCTA from '@/components/sections/ConsultationCTA.astro';
import FAQAccordion from '@/components/ui/FAQAccordion.astro';
import { site } from '@/data/site';
import { articleSchema, faqSchema } from '@/utils/schema';
import { formatDate } from '@/utils/format';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

const { article } = Astro.props;
const { Content } = await render(article);

const author = await getEntry('team', article.data.author.id);
const authorBio = author?.data.bio.replace(/\s*\[OWNER TO CONFIRM:[^\]]*\]\s*/g, ' ').trim();

const related = (
  await getCollection('articles', ({ data, id }) => !data.draft && id !== article.id)
)
  .filter(
    (a) =>
      a.data.category === article.data.category ||
      a.data.tags.some((t) => article.data.tags.includes(t))
  )
  .slice(0, 3);

const pageUrl = `${site.url}/resources/${article.id}`;

const pageSchemas: Array<Record<string, unknown>> = [
  articleSchema({
    title: article.data.title,
    description: article.data.description,
    url: pageUrl,
    publishDate: article.data.publishDate,
    reviewDate: article.data.reviewDate,
    authorName: author?.data.name ?? site.name,
    authorUrl: `${site.url}/team`,
  }),
];
if (article.data.faqs.length > 0) {
  pageSchemas.push(faqSchema(article.data.faqs));
}
---

<BaseLayout
  title={article.data.seoTitle ?? `${article.data.title} | Influx Financial`}
  description={article.data.description}
  ogType="article"
  schema={pageSchemas}
>
  <article>
    <header class="bg-mist-50 bg-texture">
      <div class="container-site max-w-4xl py-14 sm:py-16">
        <Breadcrumbs
          items={[
            { name: 'Resources', href: '/resources' },
            { name: article.data.title, href: `/resources/${article.id}` },
          ]}
          class="mb-6 text-ink-500"
        />
        <p class="mb-3 text-[0.8rem] font-bold uppercase tracking-[0.14em] text-pine-700">
          {article.data.category}
        </p>
        <h1 class="text-3xl sm:text-4xl">{article.data.title}</h1>
        <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2 text-[0.88rem] text-ink-600">
          {
            author && (
              <span class="flex items-center gap-2.5">
                <img
                  src={author.data.image}
                  alt=""
                  width="36"
                  height="36"
                  class="h-9 w-9 rounded-full object-cover"
                />
                <span>
                  By{' '}
                  <a href="/team" class="font-semibold text-pine-800 underline underline-offset-2">
                    {author.data.name}
                  </a>
                  , {author.data.role}
                </span>
              </span>
            )
          }
          <span>
            Published <time datetime={article.data.publishDate.toISOString()}
              >{formatDate(article.data.publishDate)}</time
            >
          </span>
          <span>
            Reviewed <time datetime={article.data.reviewDate.toISOString()}
              >{formatDate(article.data.reviewDate)}</time
            >
          </span>
        </div>
      </div>
    </header>

    <div class="bg-white">
      <div
        class="container-site max-w-3xl py-12 text-[1.05rem] leading-[1.8] sm:py-16
        [&_a]:font-semibold [&_a]:text-pine-800 [&_a]:underline [&_a]:underline-offset-2
        [&_blockquote]:border-l-4 [&_blockquote]:border-sage-300 [&_blockquote]:pl-4 [&_blockquote]:italic
        [&_em]:italic
        [&_h2]:mb-4 [&_h2]:mt-10 [&_h2]:text-2xl [&_h2]:font-bold
        [&_h3]:mb-3 [&_h3]:mt-8 [&_h3]:text-xl [&_h3]:font-bold
        [&_li]:mb-2 [&_ol]:mb-5 [&_ol]:list-decimal [&_ol]:pl-6
        [&_p]:mb-5 [&_strong]:font-bold [&_strong]:text-ink-900
        [&_ul]:mb-5 [&_ul]:list-disc [&_ul]:pl-6
        [&_table]:my-8 [&_table]:w-full [&_table]:overflow-hidden [&_table]:rounded-xl [&_table]:border [&_table]:border-line-100 [&_table]:border-separate [&_table]:[border-spacing:0] [&_table]:text-[0.92rem]
        [&_th]:bg-pine-950 [&_th]:px-3.5 [&_th]:py-3 [&_th]:text-left [&_th]:font-bold [&_th]:text-white
        [&_td]:border-t [&_td]:border-line-100 [&_td]:px-3.5 [&_td]:py-3
        [&_tbody_tr:nth-child(even)]:bg-mist-50
        [&_td:first-child]:font-semibold [&_td:first-child]:text-ink-900"
      >
        <Content />

        {
          article.data.faqs.length > 0 && (
            <>
              <h2>Common questions</h2>
              <FAQAccordion items={article.data.faqs} class="mt-6" />
            </>
          )
        }

        {
          author && (
            <aside class="mt-12 flex gap-4 rounded-2xl border border-line-100 bg-mist-50 p-6 not-italic">
              <img
                src={author.data.image}
                alt={author.data.imageAlt}
                width="64"
                height="64"
                class="h-16 w-16 shrink-0 rounded-full object-cover"
              />
              <div class="text-[0.92rem] leading-relaxed">
                <p class="font-bold text-ink-950">
                  {author.data.name}, {author.data.role}
                </p>
                <p class="mt-1 text-ink-600">{authorBio}</p>
              </div>
            </aside>
          )
        }
      </div>
    </div>
  </article>

  {
    related.length > 0 && (
      <section class="bg-mist-50">
        <div class="container-site py-16">
          <h2 class="mb-6 text-2xl font-bold">Keep reading</h2>
          <div class="grid gap-5 md:grid-cols-3">
            {related.map((rel, i) => (
              <ArticleCard
                title={rel.data.title}
                description={rel.data.description}
                href={`/resources/${rel.id}`}
                category={rel.data.category}
                publishDate={rel.data.publishDate}
                delay={i * 60}
              />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <ConsultationCTA
    heading="Questions this guide didn't answer?"
    body="Bring them to a free 30-minute consultation, tax and mortgage questions welcome."
  />
</BaseLayout>
