---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/navigation/Breadcrumbs.astro';
import SectionHeader from '@/components/sections/SectionHeader.astro';
import FAQAccordion from '@/components/ui/FAQAccordion.astro';
import ConsultationCTA from '@/components/sections/ConsultationCTA.astro';
import { faqSchema } from '@/utils/schema';

const groups = (await getCollection('faqs')).sort((a, b) => a.data.order - b.data.order);
const allItems = groups.flatMap((g) => g.data.items);
---

<BaseLayout
  title="Frequently Asked Questions | Influx Financial"
  description="Straight answers about mortgage brokers, costs, pre-approval, deposits, first home buying and refinancing — from the Influx Financial team."
  schema={[faqSchema(allItems)]}
>
  <section class="bg-mist-50 bg-texture">
    <div class="container-site py-14 sm:py-16">
      <Breadcrumbs items={[{ name: 'FAQ', href: '/faq' }]} class="mb-6 text-ink-500" />
      <SectionHeader
        as="h1"
        eyebrow="FAQ"
        heading="Ask us anything — these got asked first"
        lede="Grouped by topic. If your question isn't here, call or send it through — we answer the same day where we can."
      />
    </div>
  </section>

  <section class="bg-white">
    <div class="container-site max-w-4xl space-y-12 py-16 sm:py-20">
      {
        groups.map((group) => (
          <div data-reveal>
            <h2 class="mb-5 text-2xl font-bold">{group.data.category}</h2>
            <FAQAccordion items={group.data.items} />
          </div>
        ))
      }
    </div>
  </section>

  <ConsultationCTA
    heading="Still have a question?"
    body="Bring it to a free consultation, or send it through the contact form — no question is too basic."
  />
</BaseLayout>
