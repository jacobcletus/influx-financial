---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import SectionHeader from '@/components/sections/SectionHeader.astro';
import ServiceCard from '@/components/ui/ServiceCard.astro';
import TeamCard from '@/components/ui/TeamCard.astro';
import ArticleCard from '@/components/ui/ArticleCard.astro';
import ProcessSteps from '@/components/sections/ProcessSteps.astro';
import TrustBar from '@/components/sections/TrustBar.astro';
import ConsultationCTA from '@/components/sections/ConsultationCTA.astro';
import FAQAccordion from '@/components/ui/FAQAccordion.astro';
import AwardBadges from '@/components/ui/AwardBadges.astro';
import { site } from '@/data/site';
import { faqSchema } from '@/utils/schema';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const team = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);
const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);
const caseStudies = (await getCollection('caseStudies')).filter(
  (c) => c.data.approved && !c.data.draft
);

const brokerFaqs = (await getEntry('faqs', 'working-with-a-broker'))!.data.items.slice(0, 4);

const heroHeading = 'The right loan, found for you. Not sold to you';
const heroWords = heroHeading.split(' ');

/**
 * The "How it works" steps below mirror the service process.
 * Confirmed accurate by the owner (Jul 2026).
 */
const processSteps = [
  {
    title: 'Discovery call',
    body: 'A free, no-obligation chat about your goals, timing and questions.',
  },
  {
    title: 'Financial assessment',
    body: 'We review your income, commitments and deposit to map your real borrowing position.',
  },
  {
    title: 'Compare your options',
    body: 'A clear shortlist from our lender panel, with the trade-offs explained in plain English.',
  },
  {
    title: 'Application support',
    body: 'We prepare, lodge and manage your application, and chase the lender so you don’t have to.',
  },
  {
    title: 'Approval & ongoing support',
    body: 'Through settlement and beyond, with regular reviews to keep your loan competitive.',
  },
];

const whyPoints = [
  {
    icon: 'compass',
    title: 'Personalised guidance',
    body: 'Advice built on your numbers and plans, not a script. You deal with a director, not a call centre.',
  },
  {
    icon: 'layers',
    title: 'Broad lender access',
    body: 'A wide panel of banks and specialist lenders means your situation is matched to policy, not forced into one bank’s box.',
  },
  {
    icon: 'mail',
    title: 'Clear communication',
    body: 'You’ll always know where your application is up to and what happens next, in plain English.',
  },
  {
    icon: 'calculator',
    title: 'Lending + accounting together',
    body: 'With OneHQ Accounting in the same team, your loan structure and tax position are planned side by side.',
  },
  {
    icon: 'shield',
    title: 'Best interests, by law and by habit',
    body: 'Mortgage brokers owe consumers a best interests duty. We built the business around taking it seriously.',
  },
  {
    icon: 'clock',
    title: 'Support that outlasts settlement',
    body: 'Regular loan reviews and a team that answers the phone next year, not just this month.',
  },
];
---

<BaseLayout
  title="Influx Financial | Mortgage Brokers & Accountants Melbourne"
  description="Melbourne mortgage broking, lending and accounting. Influx Financial compares home loans from a wide lender panel, first home buyers, refinancing, investors and business owners. Free consultation."
  schema={[faqSchema(brokerFaqs)]}
>
  <!-- ============ HERO ============ -->
  <section class="bg-glow-dark on-dark relative overflow-hidden bg-pine-950">
    <div
      class="container-site relative grid items-center gap-14 py-20 sm:py-24 lg:grid-cols-[1fr_1.05fr] lg:py-28"
    >
      <div>
        <p class="eyebrow eyebrow-rule mb-7 text-gold-200" data-reveal>
          {site.tagline.charAt(0).toUpperCase() + site.tagline.slice(1)}
        </p>
        <h1
          class="max-w-2xl text-[2.7rem] font-extrabold uppercase leading-[0.98] tracking-[-0.02em] text-white sm:text-6xl lg:text-[4.5rem]"
        >
          {
            heroWords.map((word, i) => (
              <>
                <span class="hero-word" style={`--word-index: ${i}`}>
                  {word}
                </span>{' '}
              </>
            ))
          }
        </h1>
        <p
          class="mt-7 max-w-lg text-lg leading-relaxed text-sage-200"
          data-reveal
          style="--reveal-delay: 350ms"
        >
          Influx Financial is a Melbourne mortgage broking and accounting team. We compare loans
          across a wide panel of lenders for first home buyers, refinancers, investors and business
          owners, and manage everything through to settlement.
        </p>
        <div
          class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center"
          data-reveal
          style="--reveal-delay: 450ms"
        >
          <Button href="/book-consultation" variant="gold" size="lg">
            Book a Free Consultation
            <Icon
              name="arrow-right"
              size={17}
              class="transition-transform duration-200 motion-safe:group-hover:translate-x-0.5"
            />
          </Button>
          <a
            href={site.contact.phoneHref}
            class="inline-flex items-center justify-center gap-2 rounded-full border border-white/25 px-7 py-3.5 text-base font-semibold text-white transition-colors hover:bg-white/10"
          >
            <Icon name="phone" size={17} />
            {site.contact.phone}
          </a>
        </div>

        <ul
          class="mt-8 flex max-w-lg flex-wrap gap-x-6 gap-y-2 border-t border-white/15 pt-6 text-[0.85rem] font-medium text-sage-200"
          data-reveal
          style="--reveal-delay: 680ms"
        >
          <li class="flex items-center gap-1.5">
            <Icon name="check" size={14} class="text-gold-200" /> No cost to you for most home loans
          </li>
          <li class="flex items-center gap-1.5">
            <Icon name="check" size={14} class="text-gold-200" /> Broking + accounting, one team
          </li>
          <li class="flex items-center gap-1.5">
            <Icon name="check" size={14} class="text-gold-200" /> Melbourne based
          </li>
        </ul>
      </div>

      <!-- Real team imagery — premium framed portraits with names -->
      <div
        class="relative mx-auto hidden w-full max-w-2xl sm:block lg:mr-0"
        data-reveal
        style="--reveal-delay: 250ms"
      >
        <div class="grid grid-cols-2 gap-6">
          <figure
            class="group overflow-hidden rounded-[1.5rem] bg-white shadow-card-hover ring-1 ring-white/10"
          >
            <img
              src="/images/team/jose-poly-studio.webp"
              alt="Jose Poly, Director and Mortgage Broker at Influx Financial"
              width="900"
              height="900"
              class="aspect-square w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
              fetchpriority="high"
            />
            <figcaption class="px-4 py-4">
              <p class="text-sm font-bold text-ink-950">Jose Poly</p>
              <p class="mt-0.5 text-[0.66rem] font-semibold uppercase tracking-[0.08em] text-pine-700">
                Director &amp; Mortgage Broker
              </p>
            </figcaption>
          </figure>
          <figure
            class="group overflow-hidden rounded-[1.5rem] bg-white shadow-card-hover ring-1 ring-white/10"
          >
            <img
              src="/images/team/joe-anto-studio.webp"
              alt="Joe Anto, Director of Influx Financial and OneHQ Accounting"
              width="900"
              height="900"
              class="aspect-square w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
              fetchpriority="high"
            />
            <figcaption class="px-4 py-4">
              <p class="text-sm font-bold text-ink-950">Joe Anto</p>
              <p class="mt-0.5 text-[0.66rem] font-semibold uppercase tracking-[0.08em] text-pine-700">
                Director, Accounting
              </p>
            </figcaption>
          </figure>
        </div>
        <!-- AFG Broker Awards 2026 finalist seals, under the photos -->
        <AwardBadges
          imgClass="h-16 w-16 ring-1 ring-white/15 sm:h-20 sm:w-20"
          gap="gap-4"
          class="mt-6 justify-center"
          data-reveal
          style="--reveal-delay: 400ms"
        />

        <div class="mt-5 flex flex-wrap items-center justify-center gap-3">
          <div class="flex items-center gap-2.5 rounded-full bg-white py-2 pl-3 pr-5 shadow-card">
            <span class="flex h-7 w-7 items-center justify-center rounded-full bg-pine-800 text-white">
              <Icon name="layers" size={14} />
            </span>
            <span class="whitespace-nowrap text-[0.8rem] font-bold text-ink-950">
              70+ lenders <span class="font-medium text-ink-500">on our panel</span>
            </span>
          </div>
          <div class="flex items-center gap-2.5 rounded-full bg-white py-2 pl-3 pr-5 shadow-card">
            <span class="flex h-7 w-7 items-center justify-center rounded-full bg-gold-400 text-pine-950">
              <Icon name="users" size={14} />
            </span>
            <span class="whitespace-nowrap text-[0.8rem] font-semibold text-ink-900">
              The directors you'll actually deal with
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ TRUST BAR ============ -->
  <TrustBar />

  <!-- ============ STATEMENT ============ -->
  <section class="bg-texture bg-mist-50">
    <div class="container-site py-24 sm:py-28">
      <figure class="relative overflow-hidden rounded-[1.75rem] shadow-card-hover" data-reveal>
        <img
          src="/images/proper-house.webp"
          alt="Modern two-storey home with glass balustrades and landscaped entry"
          width="1600"
          height="1000"
          loading="lazy"
          class="aspect-[4/5] w-full object-cover sm:aspect-[16/9] lg:aspect-[2/1]"
        />
        <div
          aria-hidden="true"
          class="absolute inset-0 bg-gradient-to-t from-pine-950/85 via-pine-950/35 to-pine-950/20"
        >
        </div>
        <figcaption class="absolute inset-0 flex items-end justify-center p-8 sm:p-12">
          <p
            class="font-display max-w-3xl text-center text-[1.7rem] font-extrabold uppercase leading-[1.08] tracking-[-0.015em] text-white sm:text-[2.4rem] lg:text-[2.8rem]"
          >
            Compare widely. Structure smartly.
            <span class="text-gold-200">Settle with confidence.</span>
          </p>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- ============ SERVICES OVERVIEW ============ -->
  <section class="bg-white">
    <div class="container-site py-24 sm:py-28">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <SectionHeader
          eyebrow="What we do"
          heading="Lending and accounting, matched to the moment you're in"
          lede="From a first deposit to a business premises, each service has its own specialists, process and detailed guide."
        />
        <Button href="/services" variant="secondary" class="mb-1 hidden sm:inline-flex">
          All services
          <Icon name="arrow-right" size={15} />
        </Button>
      </div>
      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          services
            .slice(0, 6)
            .map((service, i) => (
              <ServiceCard
                title={service.data.navLabel}
                description={service.data.metaDescription.split('.')[0] + '.'}
                href={`/services/${service.id}`}
                icon={service.data.icon}
                delay={i * 60}
              />
            ))
        }
      </div>
      <div class="mt-8 text-center sm:hidden">
        <Button href="/services" variant="secondary">See all services</Button>
      </div>
    </div>
  </section>

  <!-- ============ TEAM ============ -->
  <section class="bg-mist-50">
    <div class="container-site py-24 sm:py-28">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <SectionHeader
          eyebrow="Your team"
          heading="Two directors, one conversation"
          lede="Lending on one side, accounting on the other, and you get both."
        />
        <Button href="/team" variant="secondary" class="mb-1">
          Meet the team
          <Icon name="arrow-right" size={15} />
        </Button>
      </div>
      <div class="mx-auto mt-12 grid max-w-3xl gap-6 sm:grid-cols-2">
        {
          team.map((member, i) => (
            <TeamCard
              name={member.data.name}
              role={member.data.role}
              image={member.data.image}
              imageAlt={member.data.imageAlt}
              focus={member.data.focus}
              delay={i * 80}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ FIRST HOME BUYER FEATURE ============ -->
  <section class="bg-glow-dark on-dark bg-pine-950">
    <div class="container-site grid items-start gap-12 py-24 sm:py-28 lg:grid-cols-2">
      <div data-reveal>
        <p class="eyebrow eyebrow-rule mb-5 text-gold-200">Making first homes happen</p>
        <h2 class="text-[2.1rem] font-extrabold text-white sm:text-[2.6rem] lg:text-[2.9rem]">
          First home? We've made this trip before.
        </h2>
        <p class="mt-4 text-lg leading-relaxed text-sage-200">
          Deposits, schemes, pre-approval, auctions, the first purchase is the one with the most
          jargon and the highest stakes. We turn it into a step-by-step plan built on your real
          numbers, and stay beside you until the keys are in your hand.
        </p>
        <ul class="mt-6 space-y-2.5 text-[0.98rem] text-mist-100">
          <li class="flex items-start gap-2.5">
            <Icon name="check" size={17} class="mt-1 shrink-0 text-gold-200" />
            A realistic budget and deposit target before you start inspecting
          </li>
          <li class="flex items-start gap-2.5">
            <Icon name="check" size={17} class="mt-1 shrink-0 text-gold-200" />
            Government scheme eligibility checked against current criteria
          </li>
          <li class="flex items-start gap-2.5">
            <Icon name="check" size={17} class="mt-1 shrink-0 text-gold-200" />
            Pre-approval organised so you can bid and offer with confidence
          </li>
        </ul>
        <div class="mt-8">
          <Button href="/services/first-home-buyers" variant="inverse" size="lg">
            The first home buyer guide
            <Icon name="arrow-right" size={17} />
          </Button>
        </div>
      </div>
      <div
        class="rounded-[1.35rem] border border-white/10 bg-white/[0.06] p-7 shadow-card-hover backdrop-blur-sm sm:p-9"
        data-reveal
        style="--reveal-delay: 150ms"
      >
        <p class="eyebrow text-sage-300">The journey</p>
        <ol class="mt-6 space-y-5">
          {
            [
              'Free consultation & budget',
              'Savings and deposit plan',
              'Pre-approval with a matched lender',
              'House hunting & contract checks',
              'Formal approval & settlement',
            ].map((step, i) => (
              <li class="flex items-center gap-4">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-gold-200/40 text-sm font-bold text-gold-200">
                  {i + 1}
                </span>
                <span class="font-medium text-mist-100">{step}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- ============ HOW IT WORKS ============ -->
  <section class="bg-white">
    <div class="container-site grid gap-12 py-24 sm:py-28 lg:grid-cols-[0.9fr_1.1fr]">
      <div>
        <SectionHeader
          eyebrow="How it works"
          heading="A clear process from first call to keys"
          lede="No mystery, no chasing. Here's exactly what working with Influx looks like."
        />
        <div class="mt-8" data-reveal>
          <Button href="/how-it-works" variant="secondary">
            More about the process
            <Icon name="arrow-right" size={15} />
          </Button>
        </div>
      </div>
      <ProcessSteps steps={processSteps} />
    </div>
  </section>

  <!-- ============ WHY INFLUX ============ -->
  <section class="bg-mist-50">
    <div class="container-site py-24 sm:py-28">
      <SectionHeader
        eyebrow="Why Influx"
        heading="Built to be the last broker you need to find"
        align="center"
      />
      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          whyPoints.map((point, i) => (
            <div
              class="spotlight-card rounded-2xl border border-line-100 bg-white p-7 shadow-card"
              data-reveal
              style={`--reveal-delay: ${i * 50}ms`}
            >
              <span class="mb-5 flex h-12 w-12 items-center justify-center rounded-full border border-sage-200/80 bg-white text-pine-700">
                <Icon name={point.icon} size={21} />
              </span>
              <h3 class="text-[1.12rem] font-bold text-ink-950">{point.title}</h3>
              <p class="mt-2 text-[0.92rem] leading-relaxed text-ink-600">{point.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ CLIENT STORY ============ -->
  <section class="bg-white">
    <div class="container-site pb-20 sm:pb-24">
      <div
        class="bg-texture rounded-[1.75rem] border border-line-100 bg-mist-50 p-8 sm:p-12"
        data-reveal
      >
        {
          caseStudies.length > 0 ? (
            <div class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-center">
              <div>
                <p class="eyebrow mb-5 rounded-full border border-pine-800/15 bg-white px-3.5 py-1.5 text-pine-700">
                  Client story
                </p>
                <h2 class="text-2xl sm:text-3xl">{caseStudies[0].data.title}</h2>
                <p class="mt-3 max-w-2xl text-ink-600">{caseStudies[0].data.description}</p>
                <p class="mt-4 text-xs text-ink-500">
                  Outcomes are specific to this client's circumstances and not a prediction of
                  results for other borrowers.
                </p>
              </div>
              <Button href={`/case-studies/${caseStudies[0].id}`} variant="secondary">
                Read the story
                <Icon name="arrow-right" size={15} />
              </Button>
            </div>
          ) : (
            <div class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-center">
              <div>
                <p class="eyebrow mb-5 rounded-full border border-pine-800/15 bg-white px-3.5 py-1.5 text-pine-700">
                  Client stories
                </p>
                <h2 class="text-2xl sm:text-3xl">Real outcomes, told properly</h2>
                <p class="mt-3 max-w-2xl text-ink-600">
                  We're preparing de-identified client stories, the challenge, the approach and the
                  verified outcome, with each client's consent. No manufactured success stories,
                  ever.
                </p>
              </div>
              <Button href="/case-studies" variant="secondary">
                About our case studies
                <Icon name="arrow-right" size={15} />
              </Button>
            </div>
          )
        }
      </div>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section class="bg-white">
    <div class="container-site grid gap-12 py-24 sm:py-28 lg:grid-cols-[0.9fr_1.1fr]">
      <div>
        <SectionHeader
          eyebrow="Questions"
          heading="The things people ask first"
          lede="Straight answers about brokers, costs and the process."
        />
        <div class="mt-8" data-reveal>
          <Button href="/faq" variant="secondary">
            All FAQs
            <Icon name="arrow-right" size={15} />
          </Button>
        </div>
      </div>
      <div data-reveal style="--reveal-delay: 120ms">
        <FAQAccordion items={brokerFaqs} />
      </div>
    </div>
  </section>

  <!-- ============ RESOURCES ============ -->
  <section class="bg-mist-50">
    <div class="container-site py-24 sm:py-28">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <SectionHeader
          eyebrow="Resources"
          heading="Guides worth your reading time"
          lede="Written by the team, reviewed for accuracy, free of fluff."
        />
        <Button href="/resources" variant="secondary" class="mb-1">
          All resources
          <Icon name="arrow-right" size={15} />
        </Button>
      </div>
      <div class="mt-12 grid gap-5 md:grid-cols-3">
        {
          articles.map((article, i) => (
            <ArticleCard
              title={article.data.title}
              description={article.data.description}
              href={`/resources/${article.id}`}
              category={article.data.category}
              publishDate={article.data.publishDate}
              delay={i * 70}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ CLOSING CTA ============ -->
  <ConsultationCTA />
</BaseLayout>
