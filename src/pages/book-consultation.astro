---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/navigation/Breadcrumbs.astro';
import Icon from '@/components/ui/Icon.astro';
import ConsultationForm from '@/components/forms/ConsultationForm';
import { site } from '@/data/site';

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined;

const expectations = [
  'A realistic view of your borrowing range or refinance savings',
  'Answers to your mortgage and tax questions in plain English',
  'A clear next step — even if it’s “wait six months, and here’s why”',
];
---

<BaseLayout
  title="Book a Free 30-Minute Consultation | Influx Financial"
  description="Book a free 30-minute tax and mortgage consultation with Influx Financial. No obligation — leave with a clear next step for your situation."
>
  <section class="bg-pine-950 bg-texture-dark on-dark">
    <div class="container-site py-14 sm:py-16">
      <Breadcrumbs
        items={[{ name: 'Book a Consultation', href: '/book-consultation' }]}
        class="mb-6 text-sage-300"
      />
      <div class="max-w-3xl">
        <p class="mb-3 text-[0.8rem] font-bold uppercase tracking-[0.14em] text-gold-200">
          Free 30-minute consultation
        </p>
        <h1 class="text-3xl text-white sm:text-4xl lg:text-[2.75rem]">
          Thirty minutes that beats thirty browser tabs
        </h1>
        <p class="mt-5 text-lg leading-relaxed text-sage-200">
          Tax and mortgage questions welcome — one conversation with people who work both sides.
          Free, no obligation, and honest even when the honest answer is "not yet".
        </p>
        <ul class="mt-7 space-y-2.5">
          {
            expectations.map((item) => (
              <li class="flex items-start gap-2.5 text-[0.98rem] text-mist-100">
                <Icon name="check" size={17} class="mt-1 shrink-0 text-gold-200" />
                {item}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="container-site grid gap-12 py-16 sm:py-20 lg:grid-cols-[1.15fr_0.85fr]">
      <div class="rounded-3xl border border-line-100 bg-mist-50 p-6 sm:p-9">
        <h2 class="text-2xl font-bold">Request your consultation</h2>
        <p class="mb-7 mt-1.5 text-[0.92rem] text-ink-600">
          Tell us a little about your situation and preferred time — we'll confirm by phone or
          email within one business day.
        </p>
        <ConsultationForm client:visible turnstileSiteKey={turnstileSiteKey} />
      </div>

      <div class="space-y-5">
        {
          site.booking.calendarUrl ? (
            <div class="rounded-2xl border border-line-100 bg-white p-6 shadow-card">
              <h2 class="font-bold text-ink-950">Prefer to pick a time yourself?</h2>
              <a
                href={site.booking.calendarUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-3 inline-block rounded-full bg-pine-700 px-5 py-2.5 text-[0.92rem] font-semibold text-white hover:bg-pine-800"
              >
                Open the booking calendar
              </a>
            </div>
          ) : (
            <div class="rounded-2xl border border-dashed border-sage-300 bg-mist-50 p-6">
              <h2 class="font-bold text-ink-950">Online calendar coming soon</h2>
              <p class="mt-1.5 text-[0.9rem] leading-relaxed text-ink-600">
                Self-service booking is on its way.
                <!-- [OWNER TO CONFIRM: Calendly or preferred booking platform link — set in src/data/site.ts booking.calendarUrl] -->
                For now, the form or a phone call gets you a confirmed time within a business day.
              </p>
            </div>
          )
        }
        <a
          href={site.contact.phoneHref}
          class="flex items-center gap-4 rounded-2xl border border-line-100 bg-white p-6 shadow-card transition-all hover:border-sage-200 hover:shadow-card-hover"
        >
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-mist-100 text-pine-700">
            <Icon name="phone" size={24} />
          </span>
          <span>
            <span class="block text-sm font-semibold text-ink-500">Rather just call?</span>
            <span class="block text-lg font-bold text-ink-950">{site.contact.phone}</span>
          </span>
        </a>
        <div class="rounded-2xl border border-line-100 bg-white p-6 shadow-card">
          <h2 class="font-bold text-ink-950">What happens after you book</h2>
          <ol class="mt-3 space-y-2.5 text-[0.92rem] text-ink-600">
            <li class="flex gap-2.5">
              <span class="font-bold text-pine-700">1.</span> We confirm your time and how you'd like to meet (phone or video).
            </li>
            <li class="flex gap-2.5">
              <span class="font-bold text-pine-700">2.</span> The consultation — your questions first, then our assessment of options.
            </li>
            <li class="flex gap-2.5">
              <span class="font-bold text-pine-700">3.</span> A written summary of what we discussed and your next step. No pressure, no spam.
            </li>
          </ol>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
