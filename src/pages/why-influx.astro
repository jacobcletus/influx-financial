---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/navigation/Breadcrumbs.astro';
import Icon from '@/components/ui/Icon.astro';
import SectionHeader from '@/components/sections/SectionHeader.astro';
import ConsultationCTA from '@/components/sections/ConsultationCTA.astro';
import { comparisonDisclaimer } from '@/data/site';

const reasons = [
  {
    icon: 'users',
    title: 'You deal with directors',
    body: 'Jose and Joe run the files they take on. No hand-offs to a processing team you’ve never met, no re-explaining your situation to a new voice each call.',
  },
  {
    icon: 'layers',
    title: 'A wide panel, used properly',
    body: 'Access to many lenders only matters if your broker understands the policy differences between them. Matching your income type, deposit and property to the right lender’s criteria is the actual job, rate comparison is the easy part.',
  },
  {
    icon: 'calculator',
    title: 'Lending and accounting, one team',
    body: 'Through OneHQ Accounting, your loan structure and tax position get planned together. For self-employed borrowers and investors this isn’t a nice-to-have, it’s the difference between a clean structure and years of untangling.',
  },
  {
    icon: 'mail',
    title: 'Communication you don’t have to chase',
    body: 'You’ll know what stage your application is at, what the lender asked for, and what happens next. If something slows down, you hear it from us first.',
  },
  {
    icon: 'shield',
    title: 'Advice bound to your interests',
    body: 'Mortgage brokers owe consumers a legal best interests duty when recommending loans, banks’ own staff don’t. We document why the recommended option fits you.',
  },
  {
    icon: 'refresh',
    title: 'Reviews that keep your loan honest',
    body: 'Settlement isn’t the finish line. We review client loans periodically and renegotiate or refinance when the numbers justify it, that’s how a broker earns the long game.',
  },
];
---

<BaseLayout
  title="Why Choose Influx Financial, What Makes Us Different"
  description="Director-led service, a wide lender panel used properly, and accounting under the same roof. The honest case for choosing Influx, without the marketing claims."
>
  <section class="bg-mist-50 bg-texture">
    <div class="container-site py-14 sm:py-16">
      <Breadcrumbs
        items={[{ name: 'Why Influx', href: '/why-influx' }]}
        class="mb-6 text-ink-500"
      />
      <div class="max-w-3xl">
        <p class="mb-3 text-[0.8rem] font-bold uppercase tracking-[0.14em] text-pine-700">
          Why Influx
        </p>
        <h1 class="text-3xl sm:text-4xl lg:text-[2.75rem]">The honest case for choosing us</h1>
        <p class="mt-5 text-lg leading-relaxed text-ink-600">
          No "best rates guaranteed", no manufactured urgency. Here's what's genuinely different
          about how Influx works, judge for yourself whether it fits what you need.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="container-site py-16 sm:py-20">
      <div class="grid gap-5 md:grid-cols-2">
        {
          reasons.map((r, i) => (
            <div
              class="spotlight-card flex gap-5 rounded-2xl border border-line-100 bg-white p-7 shadow-card"
              data-reveal
              style={`--reveal-delay: ${(i % 2) * 70}ms`}
            >
              <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-mist-100 text-pine-700">
                <Icon name={r.icon} size={24} />
              </span>
              <div>
                <h2 class="text-lg font-bold text-ink-950">{r.title}</h2>
                <p class="mt-1.5 text-[0.95rem] leading-relaxed text-ink-600">{r.body}</p>
              </div>
            </div>
          ))
        }
      </div>
      <p class="mt-10 max-w-3xl text-[0.82rem] leading-relaxed text-ink-500">
        {comparisonDisclaimer}
      </p>
    </div>
  </section>

  <section class="bg-mist-50">
    <div class="container-site py-16 sm:py-20">
      <SectionHeader
        eyebrow="And what we won't claim"
        heading="Things you won't read on this website"
        align="center"
      />
      <div class="mx-auto mt-10 max-w-2xl space-y-3" data-reveal>
        {
          [
            '"Best rates guaranteed", nobody can guarantee that honestly.',
            '"Stress-free, guaranteed", property purchases have stressful moments; our job is managing them, not pretending they don’t exist.',
            'Testimonials we can’t verify, or statistics we can’t back.',
            'Pressure tactics. If you need time to think, take it.',
          ].map((item) => (
            <p class="flex items-start gap-3 rounded-xl border border-line-100 bg-white px-5 py-4 text-[0.98rem] text-ink-700">
              <Icon name="close" size={18} class="mt-1 shrink-0 text-pine-700" />
              {item}
            </p>
          ))
        }
      </div>
    </div>
  </section>

  <ConsultationCTA />
</BaseLayout>
