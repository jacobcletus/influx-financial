---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/navigation/Breadcrumbs.astro';
import SectionHeader from '@/components/sections/SectionHeader.astro';
import ProcessSteps from '@/components/sections/ProcessSteps.astro';
import FAQAccordion from '@/components/ui/FAQAccordion.astro';
import ConsultationCTA from '@/components/sections/ConsultationCTA.astro';
import Icon from '@/components/ui/Icon.astro';
import { getEntry } from 'astro:content';

/** End-to-end process, confirmed accurate by the owner (Jul 2026). */
const steps = [
  {
    title: 'Discovery call, free, 30 minutes',
    body: 'We talk through your goals, timing and questions. You don’t need documents yet; you leave knowing whether and how we can help, and what happens next.',
  },
  {
    title: 'Financial assessment',
    body: 'With your consent we review income, commitments, deposit and credit position, and calculate your borrowing range across multiple lenders, not just one.',
  },
  {
    title: 'Compare appropriate options',
    body: 'You get a short, explained list of loan options matched to your situation. We walk through the trade-offs until the choice feels like yours, because it is.',
  },
  {
    title: 'Application support',
    body: 'We package the application to the chosen lender’s requirements, lodge it, respond to assessor queries and keep you updated at every milestone.',
  },
  {
    title: 'Approval and ongoing support',
    body: 'We coordinate settlement with your conveyancer and lender, then stay in touch with periodic reviews so your loan keeps earning its place.',
  },
];

const expectations = [
  {
    icon: 'clock',
    title: 'Response times',
    body: 'Enquiries answered within one business day. Application milestones flagged to you as they happen.',
  },
  {
    icon: 'document',
    title: 'What we need from you',
    body: 'Honest numbers and timely documents. We give you a personalised checklist so there’s no guessing.',
  },
  {
    icon: 'shield',
    title: 'Your data',
    body: 'Your information is collected and used as set out in our Privacy Policy, and never sold. Sensitive documents move through secure channels, not email attachments to strangers.',
  },
];

const brokerFaqs = (await getEntry('faqs', 'working-with-a-broker'))!.data.items;
---

<BaseLayout
  title="How It Works, Working With Influx Financial"
  description="The Influx process step by step: discovery call, financial assessment, comparing options, application support, and ongoing reviews after settlement."
>
  <section class="bg-mist-50 bg-texture">
    <div class="container-site py-14 sm:py-16">
      <Breadcrumbs
        items={[{ name: 'How It Works', href: '/how-it-works' }]}
        class="mb-6 text-ink-500"
      />
      <div class="max-w-3xl">
        <p class="mb-3 text-[0.8rem] font-bold uppercase tracking-[0.14em] text-pine-700">
          How it works
        </p>
        <h1 class="text-3xl sm:text-4xl lg:text-[2.75rem]">Five steps, no mystery</h1>
        <p class="mt-5 text-lg leading-relaxed text-ink-600">
          Whether it's a first home, a refinance or a commercial facility, the shape of the process
          is the same, and you should know it before you commit an hour to anyone.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="container-site max-w-4xl py-16 sm:py-20">
      <ProcessSteps steps={steps} />
    </div>
  </section>

  <section class="bg-mist-50">
    <div class="container-site py-16 sm:py-20">
      <SectionHeader eyebrow="Ground rules" heading="What you can expect from us" />
      <div class="mt-10 grid gap-5 md:grid-cols-3">
        {
          expectations.map((e, i) => (
            <div
              class="rounded-2xl border border-line-100 bg-white p-6 shadow-card"
              data-reveal
              style={`--reveal-delay: ${i * 70}ms`}
            >
              <span class="mb-4 flex h-11 w-11 items-center justify-center rounded-xl bg-mist-100 text-pine-700">
                <Icon name={e.icon} size={22} />
              </span>
              <h3 class="font-bold text-ink-950">{e.title}</h3>
              <p class="mt-1.5 text-[0.92rem] leading-relaxed text-ink-600">{e.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="container-site grid gap-12 py-16 sm:py-20 lg:grid-cols-[0.8fr_1.2fr]">
      <SectionHeader
        eyebrow="Before you ask"
        heading="Process questions, answered"
        lede="Costs, timing, and how broking actually works."
      />
      <div data-reveal>
        <FAQAccordion items={brokerFaqs} />
      </div>
    </div>
  </section>

  <ConsultationCTA />
</BaseLayout>
