---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/navigation/Breadcrumbs.astro';
import SectionHeader from '@/components/sections/SectionHeader.astro';
import ConsultationCTA from '@/components/sections/ConsultationCTA.astro';
import Icon from '@/components/ui/Icon.astro';

const caseStudies = (await getCollection('caseStudies')).filter(
  (c) => c.data.approved && !c.data.draft
);
---

<BaseLayout
  title="Case Studies & Client Stories | Influx Financial"
  description="Real, de-identified client stories from Influx Financial — the challenge, the approach and the verified outcome. Published only with client consent."
>
  <section class="bg-mist-50 bg-texture">
    <div class="container-site py-14 sm:py-16">
      <Breadcrumbs
        items={[{ name: 'Case Studies', href: '/case-studies' }]}
        class="mb-6 text-ink-500"
      />
      <SectionHeader
        as="h1"
        eyebrow="Case studies"
        heading="Client stories, told with permission"
        lede="Each story covers the client's challenge, our approach, and the verified outcome — de-identified and published only with the client's consent."
      />
    </div>
  </section>

  <section class="bg-white">
    <div class="container-site py-16 sm:py-20">
      {
        caseStudies.length > 0 ? (
          <div class="grid gap-6 md:grid-cols-2">
            {caseStudies.map((cs) => (
              <a
                href={`/case-studies/${cs.id}`}
                class="group rounded-2xl border border-line-100 bg-white p-7 shadow-card transition-all duration-300 hover:border-sage-200 hover:shadow-card-hover"
                data-reveal
              >
                <p class="text-[0.78rem] font-bold uppercase tracking-wider text-pine-700">
                  {cs.data.clientType}
                </p>
                <h2 class="mt-2 text-xl font-bold text-ink-950 group-hover:text-pine-800">
                  {cs.data.title}
                </h2>
                <p class="mt-2 text-[0.95rem] leading-relaxed text-ink-600">
                  {cs.data.description}
                </p>
                <span class="mt-4 inline-block text-[0.88rem] font-semibold text-pine-700">
                  Read the story →
                </span>
              </a>
            ))}
          </div>
        ) : (
          <div
            class="mx-auto max-w-2xl rounded-3xl border border-dashed border-sage-300 bg-mist-50 p-10 text-center"
            data-reveal
          >
            <span class="mx-auto mb-5 flex h-14 w-14 items-center justify-center rounded-2xl bg-white text-pine-700 shadow-card">
              <Icon name="document" size={26} />
            </span>
            <h2 class="text-2xl font-bold">First stories being prepared</h2>
            <p class="mx-auto mt-3 max-w-lg leading-relaxed text-ink-600">
              We're gathering consent from clients to share their journeys — the deposit puzzles,
              the bank knock-backs, the settlements that came together. We'd rather publish nothing
              than publish fiction, so this page will fill up the right way.
            </p>
            <p class="mt-6 text-[0.95rem] text-ink-600">
              Want to hear relevant examples in person?
              <a
                href="/book-consultation"
                class="font-semibold text-pine-800 underline underline-offset-2"
              >
                Book a free consultation
              </a>
              and ask us about situations like yours.
            </p>
          </div>
        )
      }
      <p class="mt-10 text-center text-[0.82rem] text-ink-500">
        Outcomes described in case studies are specific to each client's circumstances and are not a
        prediction of results for other borrowers. Lending criteria apply.
      </p>
    </div>
  </section>

  <ConsultationCTA />
</BaseLayout>
