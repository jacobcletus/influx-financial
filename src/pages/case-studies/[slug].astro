---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/navigation/Breadcrumbs.astro';
import ConsultationCTA from '@/components/sections/ConsultationCTA.astro';

export async function getStaticPaths() {
  // Only approved, non-draft case studies are ever built.
  const caseStudies = (await getCollection('caseStudies')).filter(
    (c) => c.data.approved && !c.data.draft
  );
  return caseStudies.map((cs) => ({ params: { slug: cs.id }, props: { cs } }));
}

const { cs } = Astro.props;
const { Content } = await render(cs);
---

<BaseLayout
  title={cs.data.seoTitle ?? `${cs.data.title}, Case Study | Influx Financial`}
  description={cs.data.description}
>
  <article>
    <header class="bg-mist-50 bg-texture">
      <div class="container-site max-w-4xl py-14 sm:py-16">
        <Breadcrumbs
          items={[
            { name: 'Case Studies', href: '/case-studies' },
            { name: cs.data.title, href: `/case-studies/${cs.id}` },
          ]}
          class="mb-6 text-ink-500"
        />
        <p class="mb-3 text-[0.8rem] font-bold uppercase tracking-[0.14em] text-pine-700">
          {cs.data.clientType}
        </p>
        <h1 class="text-3xl sm:text-4xl">{cs.data.title}</h1>
      </div>
    </header>

    <div class="bg-white">
      <div class="container-site max-w-3xl py-12 sm:py-16">
        <div class="grid gap-5 sm:grid-cols-3">
          <div class="rounded-2xl border border-line-100 bg-mist-50 p-5">
            <h2 class="text-sm font-bold uppercase tracking-wider text-pine-700">Challenge</h2>
            <p class="mt-2 text-[0.92rem] leading-relaxed text-ink-700">{cs.data.challenge}</p>
          </div>
          <div class="rounded-2xl border border-line-100 bg-mist-50 p-5">
            <h2 class="text-sm font-bold uppercase tracking-wider text-pine-700">Approach</h2>
            <p class="mt-2 text-[0.92rem] leading-relaxed text-ink-700">{cs.data.approach}</p>
          </div>
          <div class="rounded-2xl border border-line-100 bg-mist-50 p-5">
            <h2 class="text-sm font-bold uppercase tracking-wider text-pine-700">Outcome</h2>
            <p class="mt-2 text-[0.92rem] leading-relaxed text-ink-700">{cs.data.outcome}</p>
          </div>
        </div>

        <div
          class="mt-10 text-[1.05rem] leading-[1.8]
          [&_h2]:mb-4 [&_h2]:mt-10 [&_h2]:text-2xl [&_h2]:font-bold
          [&_li]:mb-2 [&_p]:mb-5 [&_ul]:mb-5 [&_ul]:list-disc [&_ul]:pl-6"
        >
          <Content />
        </div>
      </div>
    </div>
  </article>

  <ConsultationCTA />
</BaseLayout>
