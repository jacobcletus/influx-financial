---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/navigation/Breadcrumbs.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import SectionHeader from '@/components/sections/SectionHeader.astro';
import TeamCard from '@/components/ui/TeamCard.astro';
import ConsultationCTA from '@/components/sections/ConsultationCTA.astro';

const team = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);

const values = [
  {
    icon: 'compass',
    title: 'Straight answers',
    body: 'If a refinance doesn’t stack up or the timing is wrong, we say so. Advice you can’t trust to be honest isn’t advice.',
  },
  {
    icon: 'users',
    title: 'Director-level service',
    body: 'Your file isn’t handed down a chain. The person you meet on day one is the person who manages your lending.',
  },
  {
    icon: 'shield',
    title: 'Best interests, seriously',
    body: 'Brokers owe consumers a best interests duty. We treat it as the starting line, not the finish.',
  },
  {
    icon: 'refresh',
    title: 'Long-game relationships',
    body: 'Loans get reviewed, circumstances change, and we plan to still be your first call in ten years.',
  },
];
---

<BaseLayout
  title="About Influx Financial — Melbourne Mortgage Brokers & Accountants"
  description="Influx Financial pairs mortgage broking with accounting under one roof. Meet the Melbourne team behind 'Making first homes happen' and see how we work."
>
  <section class="bg-mist-50 bg-texture">
    <div class="container-site py-14 sm:py-16">
      <Breadcrumbs items={[{ name: 'About', href: '/about' }]} class="mb-6 text-ink-500" />
      <div class="max-w-3xl">
        <p class="mb-3 text-[0.8rem] font-bold uppercase tracking-[0.14em] text-pine-700">
          About Influx
        </p>
        <h1 class="text-3xl sm:text-4xl lg:text-[2.75rem]">
          The broker and the accountant, finally in the same room
        </h1>
        <p class="mt-5 text-lg leading-relaxed text-ink-600">
          Influx Financial is a Melbourne-based mortgage broking and lending business working
          alongside OneHQ Accounting — one team covering the two sides of your financial life that
          were always meant to talk to each other.
        </p>
      </div>
    </div>
  </section>

  <!-- Story -->
  <section class="bg-white">
    <div class="container-site grid gap-12 py-16 sm:py-20 lg:grid-cols-2">
      <div data-reveal>
        <h2 class="text-2xl sm:text-3xl">Why Influx exists</h2>
        <div class="mt-5 space-y-4 leading-relaxed text-ink-700">
          <p>
            Most people's biggest financial decisions — buying a home, investing, structuring a
            business — sit in the gap between two professionals who rarely speak to each other: the
            mortgage broker and the accountant. Loan structures get set up with avoidable tax
            consequences. Tax returns get prepared without the next loan application in mind.
          </p>
          <p>
            Influx Financial was established to close that gap. Directors Jose Poly and Joe Anto run
            the lending and accounting sides of one team — so a first home buyer, a self-employed
            borrower or a property investor gets advice that has already been checked against both
            perspectives.
          </p>
          <p>
            The name above the door is newer than the experience behind it.
            <!-- [OWNER TO CONFIRM: founding year, combined years of experience, and 2–3 sentences of company history in the founders' words] -->
          </p>
        </div>
      </div>
      <div class="grid content-start gap-4" data-reveal style="--reveal-delay: 120ms">
        <div class="rounded-2xl border border-line-100 bg-mist-50 p-6">
          <h3 class="flex items-center gap-2.5 font-bold text-ink-950">
            <Icon name="home" size={20} class="text-pine-700" /> Mortgage broking & lending
          </h3>
          <p class="mt-2 text-[0.95rem] leading-relaxed text-ink-600">
            Home, investment, construction, commercial and asset lending compared across a wide
            panel of lenders — managed from application to settlement by Influx Financial.
          </p>
        </div>
        <div class="rounded-2xl border border-line-100 bg-mist-50 p-6">
          <h3 class="flex items-center gap-2.5 font-bold text-ink-950">
            <Icon name="calculator" size={20} class="text-pine-700" /> Accounting & tax — OneHQ
          </h3>
          <p class="mt-2 text-[0.95rem] leading-relaxed text-ink-600">
            Tax returns, planning and business accounting through OneHQ Accounting — the other half
            of the same conversation.
          </p>
        </div>
        <div class="rounded-2xl bg-pine-950 p-6 text-white">
          <p class="text-[0.95rem] leading-relaxed text-sage-200">
            <span class="font-bold text-white">The practical difference:</span> when your broker already
            understands your financials and your accountant already knows your loan structure, you stop
            being the messenger between them.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="bg-mist-50">
    <div class="container-site py-16 sm:py-20">
      <SectionHeader
        eyebrow="How we work"
        heading="The standards we hold ourselves to"
        align="center"
      />
      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          values.map((v, i) => (
            <div
              class="rounded-2xl border border-line-100 bg-white p-6 shadow-card"
              data-reveal
              style={`--reveal-delay: ${i * 60}ms`}
            >
              <span class="mb-4 flex h-11 w-11 items-center justify-center rounded-xl bg-mist-100 text-pine-700">
                <Icon name={v.icon} size={22} />
              </span>
              <h3 class="font-bold text-ink-950">{v.title}</h3>
              <p class="mt-1.5 text-[0.9rem] leading-relaxed text-ink-600">{v.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Team preview -->
  <section class="bg-white">
    <div class="container-site py-16 sm:py-20">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <SectionHeader eyebrow="Leadership" heading="The directors" />
        <Button href="/team" variant="secondary" class="mb-1">
          Full team page
          <Icon name="arrow-right" size={15} />
        </Button>
      </div>
      <div class="mx-auto mt-10 grid max-w-3xl gap-6 sm:grid-cols-2">
        {
          team.map((member, i) => (
            <TeamCard
              name={member.data.name}
              role={member.data.role}
              image={member.data.image}
              imageAlt={member.data.imageAlt}
              focus={member.data.focus}
              delay={i * 80}
            />
          ))
        }
      </div>
    </div>
  </section>

  <ConsultationCTA />
</BaseLayout>
