---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/navigation/Breadcrumbs.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import SectionHeader from '@/components/sections/SectionHeader.astro';
import TeamCard from '@/components/ui/TeamCard.astro';
import ConsultationCTA from '@/components/sections/ConsultationCTA.astro';

const team = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);

const values = [
  {
    icon: 'compass',
    title: 'Straight answers',
    body: 'If a refinance doesn’t stack up or the timing is wrong, we say so. Advice you can’t trust to be honest isn’t advice.',
  },
  {
    icon: 'users',
    title: 'Director-level service',
    body: 'Your file isn’t handed down a chain. The person you meet on day one is the person who manages your lending.',
  },
  {
    icon: 'shield',
    title: 'Best interests, seriously',
    body: 'Brokers owe consumers a best interests duty. We treat it as the starting line, not the finish.',
  },
  {
    icon: 'refresh',
    title: 'Long-game relationships',
    body: 'Loans get reviewed, circumstances change, and we plan to still be your first call in ten years.',
  },
];
---

<BaseLayout
  title="About Influx Financial, Melbourne Mortgage Brokers & Accountants"
  description="Influx Financial pairs mortgage broking with accounting under one roof. Meet the Melbourne team behind 'Making first homes happen' and see how we work."
>
  <!-- ============ HERO ============ -->
  <section class="bg-glow-dark on-dark bg-pine-950">
    <div class="container-site py-16 sm:py-20 lg:py-24">
      <Breadcrumbs items={[{ name: 'About', href: '/about' }]} class="mb-8 text-sage-300" />
      <p
        class="eyebrow mb-6 rounded-full border border-white/15 bg-white/[0.07] px-3.5 py-1.5 text-sage-300"
        data-reveal
      >
        About Influx
      </p>
      <h1
        class="max-w-3xl text-[2.2rem] font-extrabold uppercase leading-[1.02] tracking-[-0.02em] text-white sm:text-5xl lg:text-[3.6rem]"
      >
        The broker and the accountant, finally in the same room
      </h1>
      <p
        class="mt-7 max-w-2xl text-lg leading-relaxed text-sage-200"
        data-reveal
        style="--reveal-delay: 200ms"
      >
        Influx Financial is a Melbourne-based mortgage broking and lending business working
        alongside OneHQ Accounting, one team covering the two sides of your financial life that
        were always meant to talk to each other.
      </p>
    </div>
  </section>

  <!-- ============ STORY + MELBOURNE ============ -->
  <section class="bg-white">
    <div class="container-site grid items-center gap-12 py-24 sm:py-28 lg:grid-cols-[1.05fr_0.95fr]">
      <div data-reveal>
        <p class="eyebrow eyebrow-rule mb-4 text-pine-700">Our story</p>
        <h2 class="text-[2.1rem] font-extrabold sm:text-[2.6rem]">Why Influx exists</h2>
        <div class="mt-6 space-y-4 leading-relaxed text-ink-700">
          <p>
            Most people's biggest financial decisions, buying a home, investing, structuring a
            business, sit in the gap between two professionals who rarely speak to each other: the
            mortgage broker and the accountant. Loan structures get set up with avoidable tax
            consequences. Tax returns get prepared without the next loan application in mind.
          </p>
          <p>
            Influx Financial was established to close that gap. Directors Jose Poly and Joe Anto run
            the lending and accounting sides of one team, so a first home buyer, a self-employed
            borrower or a property investor gets advice that has already been checked against both
            perspectives.
          </p>
          <p>
            The name above the door is newer than the experience behind it.
          </p>
        </div>
        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          <div class="rounded-2xl border border-line-100 bg-mist-50 p-6">
            <h3 class="flex items-center gap-2.5 font-bold text-ink-950">
              <Icon name="home" size={19} class="text-pine-700" /> Broking & lending
            </h3>
            <p class="mt-2 text-[0.92rem] leading-relaxed text-ink-600">
              Home, investment, construction, commercial and asset lending compared across a wide
              panel, managed to settlement by Influx Financial.
            </p>
          </div>
          <div class="rounded-2xl border border-line-100 bg-mist-50 p-6">
            <h3 class="flex items-center gap-2.5 font-bold text-ink-950">
              <Icon name="calculator" size={19} class="text-pine-700" /> Accounting, OneHQ
            </h3>
            <p class="mt-2 text-[0.92rem] leading-relaxed text-ink-600">
              Tax returns, planning and business accounting through OneHQ Accounting, the other
              half of the same conversation.
            </p>
          </div>
        </div>
      </div>

      <figure
        class="relative mx-auto w-full max-w-md overflow-hidden rounded-[1.75rem] shadow-card-hover lg:max-w-none"
        data-reveal
        style="--reveal-delay: 150ms"
      >
        <img
          src="/images/melbourne-albert-park.jpg"
          alt="Melbourne city skyline behind Albert Park Lake and its palm-lined foreshore"
          width="720"
          height="900"
          loading="lazy"
          class="aspect-[4/5] w-full object-cover"
        />
        <div
          aria-hidden="true"
          class="absolute inset-0 bg-gradient-to-t from-pine-950/70 via-transparent to-transparent"
        >
        </div>
        <figcaption class="absolute inset-x-0 bottom-0 p-7 sm:p-8">
          <p class="font-display text-xl font-extrabold uppercase leading-tight text-white sm:text-2xl">
            Made in Melbourne.
          </p>
          <p class="mt-1.5 text-[0.95rem] font-medium text-mist-100">
            Working with clients Australia-wide.
          </p>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- ============ PRACTICAL DIFFERENCE ============ -->
  <section class="bg-glow-dark on-dark bg-pine-950">
    <div class="container-site py-20 text-center sm:py-24">
      <p
        class="font-display mx-auto max-w-4xl text-[1.7rem] font-extrabold uppercase leading-[1.08] tracking-[-0.015em] text-white sm:text-[2.4rem]"
        data-reveal
      >
        When your broker knows your financials and your accountant knows your loan,
        <span class="text-gold-200">you stop being the messenger.</span>
      </p>
    </div>
  </section>

  <!-- ============ VALUES ============ -->
  <section class="bg-texture bg-mist-50">
    <div class="container-site py-24 sm:py-28">
      <SectionHeader
        eyebrow="How we work"
        heading="The standards we hold ourselves to"
        align="center"
      />
      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          values.map((v, i) => (
            <div
              class="spotlight-card rounded-2xl border border-line-100 bg-white p-7 shadow-card"
              data-reveal
              style={`--reveal-delay: ${i * 60}ms`}
            >
              <span class="mb-5 flex h-12 w-12 items-center justify-center rounded-full border border-sage-200/80 bg-white text-pine-700">
                <Icon name={v.icon} size={21} />
              </span>
              <h3 class="text-[1.05rem] font-bold text-ink-950">{v.title}</h3>
              <p class="mt-2 text-[0.9rem] leading-relaxed text-ink-600">{v.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ TEAM ============ -->
  <section class="bg-white">
    <div class="container-site py-24 sm:py-28">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <SectionHeader eyebrow="Leadership" heading="The directors" />
        <Button href="/team" variant="secondary" class="mb-1">
          Full team page
          <Icon name="arrow-right" size={15} />
        </Button>
      </div>
      <div class="mx-auto mt-12 grid max-w-3xl gap-6 sm:grid-cols-2">
        {
          team.map((member, i) => (
            <TeamCard
              name={member.data.name}
              role={member.data.role}
              image={member.data.image}
              imageAlt={member.data.imageAlt}
              focus={member.data.focus}
              delay={i * 80}
            />
          ))
        }
      </div>
      <figure
        class="relative mx-auto mt-6 max-w-3xl overflow-hidden rounded-[1.75rem] shadow-card-hover"
        data-reveal
      >
        <img
          src="/images/team/directors-studio.jpg"
          alt="Jose Poly and Joe Anto, directors of Influx Financial, photographed together"
          width="1800"
          height="900"
          loading="lazy"
          class="aspect-[2/1] w-full object-cover"
        />
        <div
          aria-hidden="true"
          class="absolute inset-0 bg-gradient-to-t from-pine-950/60 via-transparent to-transparent"
        >
        </div>
        <figcaption class="absolute inset-x-0 bottom-0 p-6 sm:p-7">
          <p class="font-display text-lg font-extrabold uppercase leading-tight text-white">
            Jose &amp; Joe
          </p>
          <p class="mt-1 text-[0.9rem] font-medium text-mist-100">
            Two directors, one conversation.
          </p>
        </figcaption>
      </figure>
    </div>
  </section>

  <ConsultationCTA />
</BaseLayout>
