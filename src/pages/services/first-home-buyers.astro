---
import { getEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/navigation/Breadcrumbs.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import FAQAccordion from '@/components/ui/FAQAccordion.astro';
import ProcessSteps from '@/components/sections/ProcessSteps.astro';
import SectionHeader from '@/components/sections/SectionHeader.astro';
import ConsultationCTA from '@/components/sections/ConsultationCTA.astro';
import { site, generalAdviceDisclaimer } from '@/data/site';
import { faqSchema, serviceSchema } from '@/utils/schema';
import { formatDate } from '@/utils/format';

const service = (await getEntry('services', 'first-home-buyers'))!;
const fhbFaqs = (await getEntry('faqs', 'first-home-buyers'))!.data.items;

/**
 * Government scheme content changes often. Update the entries and the
 * lastReviewed date together — thresholds are deliberately NOT stated
 * here; eligibility is confirmed against current criteria per client.
 */
const schemesLastReviewed = new Date('2026-07-01');
const schemes = [
  {
    name: 'Home Guarantee Scheme (federal)',
    body: 'Lets eligible buyers purchase with a low deposit without paying LMI, with the government guaranteeing part of the loan. Income caps, property price caps and place limits apply and are updated regularly.',
  },
  {
    name: 'First Home Owner Grant (Victoria)',
    body: 'A grant for eligible first home buyers purchasing or building a new home in Victoria. Eligibility depends on the property type, value and your circumstances.',
  },
  {
    name: 'Stamp duty exemption or concession (Victoria)',
    body: 'Eligible first home buyers pay reduced or no stamp duty under certain price thresholds — often worth more than any grant. Thresholds change, so we confirm the current position when you buy.',
  },
];

const mistakes = [
  {
    title: 'Bidding at auction without pre-approval',
    body: 'Victorian auction purchases are unconditional — no cooling-off, no finance clause. Solid pre-approval and a hard limit come first.',
  },
  {
    title: 'Maxing out the budget on day one',
    body: 'The maximum a lender offers is not a target. Leave room for rate rises, furniture, and a life.',
  },
  {
    title: 'Changing jobs mid-application',
    body: 'Probation periods complicate approvals. If a move is coming, sequence it with your purchase.',
  },
  {
    title: 'Relying on last year’s scheme rules',
    body: 'Grants and caps change between budgets. Eligibility gets checked at application time, not from an old blog post.',
  },
  {
    title: 'Forgetting the upfront costs',
    body: 'Conveyancing, inspections, insurance and moving costs land before and at settlement — they belong in the savings target.',
  },
  {
    title: 'Skipping contract review',
    body: 'A conveyancer reviewing before you sign is cheap insurance against expensive surprises.',
  },
];

const documents = [
  'Photo ID (driver licence or passport)',
  'Two recent payslips (and your latest tax return if income is variable)',
  'Three months of bank statements showing savings',
  'Statements for any existing debts or credit cards',
  'Details of any gifted funds (a signed gift letter)',
  'Rental ledger if you’re currently renting',
];

const pageUrl = `${site.url}/services/first-home-buyers`;
---

<BaseLayout
  title={service.data.seoTitle}
  description={service.data.metaDescription}
  schema={[
    serviceSchema({
      name: service.data.title,
      description: service.data.metaDescription,
      url: pageUrl,
    }),
    faqSchema(fhbFaqs),
  ]}
>
  <!-- Hero -->
  <section class="bg-pine-950 bg-texture-dark on-dark">
    <div class="container-site py-16 sm:py-20">
      <Breadcrumbs
        items={[
          { name: 'Services', href: '/services' },
          { name: 'First Home Buyers', href: '/services/first-home-buyers' },
        ]}
        class="mb-6 text-sage-300"
      />
      <div class="max-w-3xl">
        <p class="mb-3 text-[0.8rem] font-bold uppercase tracking-[0.14em] text-gold-200">
          Making first homes happen
        </p>
        <h1 class="text-3xl text-white sm:text-4xl lg:text-[2.75rem]">{service.data.h1}</h1>
        <p class="mt-5 text-lg leading-relaxed text-sage-200">{service.data.intro}</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <Button href="/book-consultation" variant="inverse" size="lg">
            Book a Free Consultation
            <Icon name="arrow-right" size={17} />
          </Button>
          <a
            href={site.contact.phoneHref}
            class="inline-flex items-center justify-center gap-2 rounded-full border border-white/25 px-7 py-3.5 text-base font-semibold text-white transition-colors hover:bg-white/10"
          >
            <Icon name="phone" size={17} />
            {site.contact.phone}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- What to prepare / deposit -->
  <section class="bg-white">
    <div class="container-site grid gap-12 py-16 sm:py-20 lg:grid-cols-2">
      <div data-reveal>
        <h2 class="text-2xl sm:text-3xl">What to prepare before you start</h2>
        <p class="mt-4 leading-relaxed text-ink-600">
          The buyers who move fastest are the ones whose paperwork and savings story are ready
          before the right listing appears. Three things matter most:
        </p>
        <ul class="mt-6 space-y-4">
          <li class="flex gap-3.5">
            <span
              class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-mist-100 text-pine-700"
            >
              <Icon name="chart" size={18} />
            </span>
            <div>
              <h3 class="font-bold text-ink-950">A consistent savings pattern</h3>
              <p class="text-[0.95rem] text-ink-600">
                Lenders like to see your deposit accumulating steadily over at least three months —
                "genuine savings" in lender language.
              </p>
            </div>
          </li>
          <li class="flex gap-3.5">
            <span
              class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-mist-100 text-pine-700"
            >
              <Icon name="layers" size={18} />
            </span>
            <div>
              <h3 class="font-bold text-ink-950">Tidy debts and limits</h3>
              <p class="text-[0.95rem] text-ink-600">
                Credit card limits count against you even at zero balance. Reducing limits and
                clearing buy-now-pay-later accounts lifts borrowing power.
              </p>
            </div>
          </li>
          <li class="flex gap-3.5">
            <span
              class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-mist-100 text-pine-700"
            >
              <Icon name="clock" size={18} />
            </span>
            <div>
              <h3 class="font-bold text-ink-950">Stable income timing</h3>
              <p class="text-[0.95rem] text-ink-600">
                Past probation in a new role is easier; if you're planning a job change, let's
                sequence it around the purchase.
              </p>
            </div>
          </li>
        </ul>
      </div>
      <div data-reveal style="--reveal-delay: 120ms">
        <h2 class="text-2xl sm:text-3xl">Deposit: what "enough" looks like</h2>
        <p class="mt-4 leading-relaxed text-ink-600">
          Twenty percent avoids lenders mortgage insurance — but it's a benchmark, not a rule.
          Buying with less is common through three main paths:
        </p>
        <div class="mt-6 space-y-4">
          <div class="rounded-xl border border-line-100 bg-mist-50 p-5">
            <h3 class="font-bold text-ink-950">Pay LMI and buy sooner</h3>
            <p class="mt-1 text-[0.95rem] text-ink-600">
              A one-off insurance premium lets you buy with a smaller deposit. Sometimes cheaper
              than saving for two more years in a rising market — sometimes not. We do that maths
              with you.
            </p>
          </div>
          <div class="rounded-xl border border-line-100 bg-mist-50 p-5">
            <h3 class="font-bold text-ink-950">A family guarantor</h3>
            <p class="mt-1 text-[0.95rem] text-ink-600">
              A parent's equity secures part of the loan, reducing or removing the cash deposit and
              LMI. Real obligations for the guarantor — we brief everyone properly.
            </p>
          </div>
          <div class="rounded-xl border border-line-100 bg-mist-50 p-5">
            <h3 class="font-bold text-ink-950">Government low-deposit schemes</h3>
            <p class="mt-1 text-[0.95rem] text-ink-600">
              Eligible buyers can purchase with as little as a 5% deposit without LMI under the
              federal scheme — subject to caps and available places. Details below.
            </p>
          </div>
        </div>
        <p class="mt-5 text-[0.95rem] text-ink-600">
          Deep dive: <a
            href="/resources/how-much-deposit-do-you-need"
            class="font-semibold text-pine-800 underline underline-offset-2"
            >how much deposit do you really need?</a
          >
        </p>
      </div>
    </div>
  </section>

  <!-- Pre-approval + process -->
  <section class="bg-mist-50">
    <div class="container-site grid gap-12 py-16 sm:py-20 lg:grid-cols-[0.9fr_1.1fr]">
      <div>
        <SectionHeader
          eyebrow="The buying process"
          heading="From first chat to front door"
          lede="Pre-approval is the hinge of the whole process: a lender's conditional assessment of your borrowing power, valid for around 90 days. Get it before you fall for a property — especially for auctions, which are unconditional in Victoria."
        />
        <div class="mt-8" data-reveal>
          <Button href="/resources/what-is-pre-approval" variant="secondary">
            Pre-approval explained
            <Icon name="arrow-right" size={15} />
          </Button>
        </div>
      </div>
      <ProcessSteps steps={service.data.process} />
    </div>
  </section>

  <!-- Government schemes -->
  <section class="bg-white">
    <div class="container-site py-16 sm:py-20">
      <SectionHeader
        eyebrow="Government help"
        heading="Schemes and grants for first home buyers"
        lede="Genuine help exists — but every scheme has income caps, property price caps and limited places, and the settings change regularly."
      />
      <div class="mt-10 grid gap-5 md:grid-cols-3">
        {
          schemes.map((scheme, i) => (
            <div
              class="rounded-2xl border border-line-100 bg-mist-50 p-6"
              data-reveal
              style={`--reveal-delay: ${i * 70}ms`}
            >
              <h3 class="font-bold text-ink-950">{scheme.name}</h3>
              <p class="mt-2 text-[0.95rem] leading-relaxed text-ink-600">{scheme.body}</p>
            </div>
          ))
        }
      </div>
      <div
        class="mt-8 flex flex-col items-start justify-between gap-4 rounded-2xl border border-sage-200 bg-mist-100 p-6 sm:flex-row sm:items-center"
        data-reveal
      >
        <div>
          <p class="font-semibold text-pine-900">
            We deliberately don't publish thresholds here — they go stale.
          </p>
          <p class="mt-1 text-[0.9rem] text-ink-600">
            We check your eligibility against the current official criteria when you're ready.
            Content last reviewed: <time datetime={schemesLastReviewed.toISOString()}
              >{formatDate(schemesLastReviewed)}</time
            >.
          </p>
        </div>
        <Button href="/book-consultation" class="shrink-0">Check my eligibility</Button>
      </div>
    </div>
  </section>

  <!-- Common mistakes -->
  <section class="bg-pine-950 bg-texture-dark on-dark">
    <div class="container-site py-16 sm:py-20">
      <SectionHeader
        eyebrow="Learn from others"
        heading="Six first-buyer mistakes we see on repeat"
        dark
      />
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          mistakes.map((m, i) => (
            <div
              class="rounded-2xl border border-white/10 bg-white/5 p-6"
              data-reveal
              style={`--reveal-delay: ${i * 50}ms`}
            >
              <h3 class="font-bold text-white">{m.title}</h3>
              <p class="mt-2 text-[0.92rem] leading-relaxed text-sage-200">{m.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Documents checklist -->
  <section class="bg-white">
    <div class="container-site grid gap-12 py-16 sm:py-20 lg:grid-cols-2">
      <div>
        <SectionHeader
          eyebrow="Get ready"
          heading="Your starting documents checklist"
          lede="This is the typical starter list — we'll give you a personalised one at your consultation."
        />
        <ul class="mt-8 space-y-3">
          {
            documents.map((doc, i) => (
              <li
                class="flex items-center gap-3 rounded-xl border border-line-100 bg-mist-50 px-5 py-3.5 text-[0.98rem] text-ink-700"
                data-reveal
                style={`--reveal-delay: ${i * 40}ms`}
              >
                <Icon name="document" size={18} class="shrink-0 text-pine-700" />
                {doc}
              </li>
            ))
          }
        </ul>
        <p class="mt-5 text-[0.95rem] text-ink-600" data-reveal>
          Full guide: <a
            href="/resources/home-loan-documents-checklist"
            class="font-semibold text-pine-800 underline underline-offset-2"
            >the complete home loan documents checklist</a
          >
        </p>
      </div>
      <div>
        <SectionHeader eyebrow="FAQs" heading="First home buyer questions" />
        <div class="mt-8" data-reveal>
          <FAQAccordion items={fhbFaqs} />
        </div>
        <p class="mt-6 text-[0.82rem] leading-relaxed text-ink-500">
          {generalAdviceDisclaimer}
        </p>
      </div>
    </div>
  </section>

  <ConsultationCTA heading={service.data.ctaHeading} body={service.data.ctaBody} />
</BaseLayout>
