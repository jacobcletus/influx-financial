---
import { getEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/navigation/Breadcrumbs.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import FAQAccordion from '@/components/ui/FAQAccordion.astro';
import ProcessSteps from '@/components/sections/ProcessSteps.astro';
import SectionHeader from '@/components/sections/SectionHeader.astro';
import ConsultationCTA from '@/components/sections/ConsultationCTA.astro';
import { site, generalAdviceDisclaimer } from '@/data/site';
import { faqSchema, serviceSchema } from '@/utils/schema';
import { formatDate } from '@/utils/format';

const service = (await getEntry('services', 'first-home-buyers'))!;
const fhbFaqs = (await getEntry('faqs', 'first-home-buyers'))!.data.items;

/**
 * Government scheme content changes often. Update the entries and the
 * lastReviewed date together, thresholds are deliberately NOT stated
 * here; eligibility is confirmed against current criteria per client.
 */
const schemesLastReviewed = new Date('2026-07-01');
const schemes = [
  {
    name: 'Home Guarantee Scheme (federal)',
    body: 'Lets eligible buyers purchase with a low deposit without paying LMI, with the government guaranteeing part of the loan. Income caps, property price caps and place limits apply and are updated regularly.',
  },
  {
    name: 'First Home Owner Grant (Victoria)',
    body: 'A grant for eligible first home buyers purchasing or building a new home in Victoria. Eligibility depends on the property type, value and your circumstances.',
  },
  {
    name: 'Stamp duty exemption or concession (Victoria)',
    body: 'Eligible first home buyers pay reduced or no stamp duty under certain price thresholds, often worth more than any grant. Thresholds change, so we confirm the current position when you buy.',
  },
];

const prepare = [
  {
    icon: 'chart',
    title: 'A consistent savings pattern',
    body: 'Lenders like to see your deposit accumulating steadily over at least three months, "genuine savings" in lender language.',
  },
  {
    icon: 'layers',
    title: 'Tidy debts and limits',
    body: 'Credit card limits count against you even at zero balance. Reducing limits and clearing buy-now-pay-later accounts lifts borrowing power.',
  },
  {
    icon: 'clock',
    title: 'Stable income timing',
    body: 'Past probation in a new role is easier; if you’re planning a job change, let’s sequence it around the purchase.',
  },
];

const depositPaths = [
  {
    title: 'Pay LMI and buy sooner',
    body: 'A one-off insurance premium lets you buy with a smaller deposit. Sometimes cheaper than saving for two more years in a rising market, sometimes not. We do that maths with you.',
  },
  {
    title: 'A family guarantor',
    body: 'A parent’s equity secures part of the loan, reducing or removing the cash deposit and LMI. Real obligations for the guarantor, we brief everyone properly.',
  },
  {
    title: 'Government low-deposit schemes',
    body: 'Eligible buyers can purchase with as little as a 5% deposit without LMI under the federal scheme, subject to caps and available places. Details below.',
  },
];

const mistakes = [
  {
    title: 'Bidding at auction without pre-approval',
    body: 'Victorian auction purchases are unconditional, no cooling-off, no finance clause. Solid pre-approval and a hard limit come first.',
  },
  {
    title: 'Maxing out the budget on day one',
    body: 'The maximum a lender offers is not a target. Leave room for rate rises, furniture, and a life.',
  },
  {
    title: 'Changing jobs mid-application',
    body: 'Probation periods complicate approvals. If a move is coming, sequence it with your purchase.',
  },
  {
    title: 'Relying on last year’s scheme rules',
    body: 'Grants and caps change between budgets. Eligibility gets checked at application time, not from an old blog post.',
  },
  {
    title: 'Forgetting the upfront costs',
    body: 'Conveyancing, inspections, insurance and moving costs land before and at settlement, they belong in the savings target.',
  },
  {
    title: 'Skipping contract review',
    body: 'A conveyancer reviewing before you sign is cheap insurance against expensive surprises.',
  },
];

const documents = [
  'Photo ID (driver licence or passport)',
  'Two recent payslips (and your latest tax return if income is variable)',
  'Three months of bank statements showing savings',
  'Statements for any existing debts or credit cards',
  'Details of any gifted funds (a signed gift letter)',
  'Rental ledger if you’re currently renting',
];

const pageUrl = `${site.url}/services/first-home-buyers`;
---

<BaseLayout
  title={service.data.seoTitle}
  description={service.data.metaDescription}
  schema={[
    serviceSchema({
      name: service.data.title,
      description: service.data.metaDescription,
      url: pageUrl,
    }),
    faqSchema(fhbFaqs),
  ]}
>
  <!-- ============ HERO ============ -->
  <section class="bg-glow-dark on-dark bg-pine-950">
    <div
      class="container-site grid items-center gap-14 py-16 sm:py-20 lg:grid-cols-[1.15fr_0.85fr] lg:py-24"
    >
      <div>
        <Breadcrumbs
          items={[
            { name: 'Services', href: '/services' },
            { name: 'First Home Buyers', href: '/services/first-home-buyers' },
          ]}
          class="mb-8 text-sage-300"
        />
        <p
          class="eyebrow mb-6 rounded-full border border-white/15 bg-white/[0.07] px-3.5 py-1.5 text-gold-200"
          data-reveal
        >
          Making first homes happen
        </p>
        <h1
          class="max-w-2xl text-[2.2rem] font-extrabold uppercase leading-[1.02] tracking-[-0.02em] text-white sm:text-5xl lg:text-[3.4rem]"
        >
          {service.data.h1}
        </h1>
        <p
          class="mt-7 max-w-xl text-lg leading-relaxed text-sage-200"
          data-reveal
          style="--reveal-delay: 200ms"
        >
          {service.data.intro}
        </p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row" data-reveal style="--reveal-delay: 350ms">
          <Button href="/book-consultation" variant="gold" size="lg">
            Book a Free Consultation
            <Icon name="arrow-right" size={17} />
          </Button>
          <a
            href={site.contact.phoneHref}
            class="inline-flex items-center justify-center gap-2 rounded-full border border-white/25 px-7 py-3.5 text-base font-semibold text-white transition-colors hover:bg-white/10"
          >
            <Icon name="phone" size={17} />
            {site.contact.phone}
          </a>
        </div>
      </div>

      <figure
        class="relative mx-auto hidden w-full max-w-md overflow-hidden rounded-[1.75rem] shadow-card-hover sm:block"
        data-reveal
        style="--reveal-delay: 250ms"
      >
        <img
          src="/images/first-home.jpg"
          alt="A young couple relaxing together on the balcony of their home"
          width="900"
          height="1125"
          class="aspect-[4/5] w-full object-cover"
          fetchpriority="high"
        />
        <div
          aria-hidden="true"
          class="absolute inset-0 bg-gradient-to-t from-pine-950/70 via-transparent to-transparent"
        >
        </div>
        <figcaption class="absolute inset-x-0 bottom-0 p-7">
          <p class="font-display text-lg font-extrabold uppercase leading-tight text-white">
            From deposit to keys.
          </p>
          <p class="mt-1 text-[0.9rem] font-medium text-mist-100">Beside you for the whole trip.</p>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- ============ WHAT TO PREPARE ============ -->
  <section class="bg-white">
    <div class="container-site py-24 sm:py-28">
      <SectionHeader
        eyebrow="Get ready"
        heading="What to prepare before you start"
        lede="The buyers who move fastest are the ones whose paperwork and savings story are ready before the right listing appears. Three things matter most."
      />
      <div class="mt-12 grid gap-5 md:grid-cols-3">
        {
          prepare.map((p, i) => (
            <div
              class="spotlight-card flex flex-col rounded-2xl border border-line-100 bg-white p-7 shadow-card"
              data-reveal
              style={`--reveal-delay: ${i * 70}ms`}
            >
              <div class="mb-5 flex items-center justify-between">
                <span class="flex h-12 w-12 items-center justify-center rounded-full border border-sage-200/80 bg-white text-pine-700">
                  <Icon name={p.icon} size={21} />
                </span>
                <span class="font-display text-sm font-bold tracking-[0.12em] text-sage-400">
                  0{i + 1}
                </span>
              </div>
              <h3 class="text-[1.08rem] font-bold text-ink-950">{p.title}</h3>
              <p class="mt-2 text-[0.92rem] leading-relaxed text-ink-600">{p.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ DEPOSIT PATHS ============ -->
  <section class="bg-texture bg-mist-50">
    <div class="container-site py-24 sm:py-28">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <SectionHeader
          eyebrow="The deposit"
          heading={'What “enough” actually looks like'}
          lede="Twenty per cent avoids lenders mortgage insurance, but it's a benchmark, not a rule. Buying with less is common through three main paths."
        />
        <Button
          href="/resources/how-much-deposit-do-you-need"
          variant="secondary"
          class="mb-1 hidden sm:inline-flex"
        >
          Deposit deep-dive
          <Icon name="arrow-right" size={15} />
        </Button>
      </div>
      <div class="mt-12 grid gap-5 md:grid-cols-3">
        {
          depositPaths.map((path, i) => (
            <div
              class="flex flex-col rounded-2xl border border-line-100 bg-white p-7 shadow-card"
              data-reveal
              style={`--reveal-delay: ${i * 70}ms`}
            >
              <span class="font-display text-sm font-bold tracking-[0.12em] text-pine-600">
                PATH 0{i + 1}
              </span>
              <h3 class="mt-3 border-t border-line-100 pt-4 text-[1.08rem] font-bold text-ink-950">
                {path.title}
              </h3>
              <p class="mt-2 flex-1 text-[0.92rem] leading-relaxed text-ink-600">{path.body}</p>
            </div>
          ))
        }
      </div>
      <div class="mt-8 text-center sm:hidden">
        <Button href="/resources/how-much-deposit-do-you-need" variant="secondary">
          Deposit deep-dive
        </Button>
      </div>
    </div>
  </section>

  <!-- ============ PRE-APPROVAL + PROCESS ============ -->
  <section class="bg-white">
    <div class="container-site grid gap-12 py-24 sm:py-28 lg:grid-cols-[0.9fr_1.1fr]">
      <div>
        <SectionHeader
          eyebrow="The buying process"
          heading="From first chat to front door"
          lede="Pre-approval is the hinge of the whole process: a lender's conditional assessment of your borrowing power, valid for around 90 days. Get it before you fall for a property, especially for auctions, which are unconditional in Victoria."
        />
        <div class="mt-8" data-reveal>
          <Button href="/resources/what-is-pre-approval" variant="secondary">
            Pre-approval explained
            <Icon name="arrow-right" size={15} />
          </Button>
        </div>
      </div>
      <ProcessSteps steps={service.data.process} />
    </div>
  </section>

  <!-- ============ GOVERNMENT SCHEMES ============ -->
  <section class="bg-texture bg-mist-50">
    <div class="container-site py-24 sm:py-28">
      <SectionHeader
        eyebrow="Government help"
        heading="Schemes and grants for first home buyers"
        lede="Genuine help exists, but every scheme has income caps, property price caps and limited places, and the settings change regularly."
      />
      <div class="mt-12 grid gap-5 md:grid-cols-3">
        {
          schemes.map((scheme, i) => (
            <div
              class="flex flex-col rounded-2xl border border-line-100 bg-white p-7 shadow-card"
              data-reveal
              style={`--reveal-delay: ${i * 70}ms`}
            >
              <h3 class="font-bold leading-snug text-ink-950">{scheme.name}</h3>
              <p class="mt-2.5 flex-1 text-[0.92rem] leading-relaxed text-ink-600">{scheme.body}</p>
            </div>
          ))
        }
      </div>
      <div
        class="bg-glow-dark mt-8 flex flex-col items-start justify-between gap-6 rounded-[1.5rem] bg-pine-950 p-8 sm:flex-row sm:items-center sm:p-9"
        data-reveal
      >
        <div>
          <p class="font-display text-lg font-extrabold uppercase tracking-[-0.01em] text-white">
            We deliberately don't publish thresholds, <span class="text-gold-200"
              >they go stale.</span
            >
          </p>
          <p class="mt-2 max-w-2xl text-[0.95rem] leading-relaxed text-sage-200">
            We check your eligibility against the current official criteria when you're ready.
            Content last reviewed: <time datetime={schemesLastReviewed.toISOString()}
              >{formatDate(schemesLastReviewed)}</time
            >.
          </p>
        </div>
        <Button href="/book-consultation" variant="gold" class="shrink-0">
          Check my eligibility
        </Button>
      </div>
    </div>
  </section>

  <!-- ============ COMMON MISTAKES ============ -->
  <section class="bg-glow-dark on-dark bg-pine-950">
    <div class="container-site py-24 sm:py-28">
      <SectionHeader eyebrow="Learn from others" heading="Six first-buyer mistakes we see on repeat" dark />
      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          mistakes.map((m, i) => (
            <div
              class="flex flex-col rounded-2xl border border-white/10 bg-white/[0.06] p-7 backdrop-blur-sm"
              data-reveal
              style={`--reveal-delay: ${i * 50}ms`}
            >
              <span class="font-display text-sm font-bold tracking-[0.12em] text-gold-200">
                0{i + 1}
              </span>
              <h3 class="mt-3 border-t border-white/10 pt-4 font-bold leading-snug text-white">
                {m.title}
              </h3>
              <p class="mt-2 flex-1 text-[0.92rem] leading-relaxed text-sage-200">{m.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ DOCUMENTS ============ -->
  <section class="bg-white">
    <div class="container-site py-24 sm:py-28">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <SectionHeader
          eyebrow="Get ready"
          heading="Your starting documents checklist"
          lede="This is the typical starter list, we'll give you a personalised one at your consultation."
        />
        <Button
          href="/resources/home-loan-documents-checklist"
          variant="secondary"
          class="mb-1 hidden sm:inline-flex"
        >
          Full checklist guide
          <Icon name="arrow-right" size={15} />
        </Button>
      </div>
      <ul class="mt-12 grid gap-4 sm:grid-cols-2">
        {
          documents.map((doc, i) => (
            <li
              class="flex items-center gap-4 rounded-2xl border border-line-100 bg-mist-50 px-6 py-5 text-[0.98rem] text-ink-700"
              data-reveal
              style={`--reveal-delay: ${i * 40}ms`}
            >
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-sage-200/80 bg-white text-pine-700">
                <Icon name="document" size={17} />
              </span>
              {doc}
            </li>
          ))
        }
      </ul>
      <div class="mt-8 text-center sm:hidden">
        <Button href="/resources/home-loan-documents-checklist" variant="secondary">
          Full checklist guide
        </Button>
      </div>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section class="bg-texture bg-mist-50">
    <div class="container-site py-24 sm:py-28">
      <SectionHeader eyebrow="FAQs" heading="First home buyer questions" align="center" />
      <div class="mx-auto mt-12 max-w-3xl" data-reveal>
        <FAQAccordion items={fhbFaqs} />
      </div>
      <p class="mx-auto mt-8 max-w-2xl text-center text-[0.82rem] leading-relaxed text-ink-500">
        {generalAdviceDisclaimer}
      </p>
    </div>
  </section>

  <ConsultationCTA heading={service.data.ctaHeading} body={service.data.ctaBody} />
</BaseLayout>
