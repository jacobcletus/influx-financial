---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/navigation/Breadcrumbs.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import FAQAccordion from '@/components/ui/FAQAccordion.astro';
import ProcessSteps from '@/components/sections/ProcessSteps.astro';
import SectionHeader from '@/components/sections/SectionHeader.astro';
import ServiceCard from '@/components/ui/ServiceCard.astro';
import ArticleCard from '@/components/ui/ArticleCard.astro';
import TeamCard from '@/components/ui/TeamCard.astro';
import ConsultationCTA from '@/components/sections/ConsultationCTA.astro';
import { site, generalAdviceDisclaimer } from '@/data/site';
import { faqSchema, serviceSchema } from '@/utils/schema';

export async function getStaticPaths() {
  const services = await getCollection('services');
  // First Home Buyers has a dedicated, extended page.
  return services
    .filter((s) => s.id !== 'first-home-buyers')
    .map((service) => ({ params: { slug: service.id }, props: { service } }));
}

const { service } = Astro.props;
const data = service.data;

const teamMember = await getEntry('team', data.teamMember);
const relatedServices = (
  await Promise.all(data.related.map((slug) => getEntry('services', slug)))
).filter((s) => s != null);
const relatedArticles = (await Promise.all(data.articles.map((slug) => getEntry('articles', slug))))
  .filter((a) => a != null)
  .filter((a) => !a.data.draft);

const pageUrl = `${site.url}/services/${service.id}`;
---

<BaseLayout
  title={data.seoTitle}
  description={data.metaDescription}
  schema={[
    serviceSchema({ name: data.title, description: data.metaDescription, url: pageUrl }),
    faqSchema(data.faqs),
  ]}
>
  <!-- Hero -->
  <section class="bg-mist-50 bg-texture">
    <div class="container-site py-14 sm:py-16">
      <Breadcrumbs
        items={[
          { name: 'Services', href: '/services' },
          { name: data.navLabel, href: `/services/${service.id}` },
        ]}
        class="mb-6 text-ink-500"
      />
      <div class="max-w-3xl">
        <p class="mb-3 text-[0.8rem] font-bold uppercase tracking-[0.14em] text-pine-700">
          {data.title}
        </p>
        <h1 class="text-3xl sm:text-4xl lg:text-[2.75rem]">{data.h1}</h1>
        <p class="mt-5 text-lg leading-relaxed text-ink-600">{data.intro}</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <Button href="/book-consultation" size="lg">
            Book a Free Consultation
            <Icon name="arrow-right" size={17} />
          </Button>
          <a
            href={site.contact.phoneHref}
            class="inline-flex items-center justify-center gap-2 rounded-full border border-line-200 bg-white px-7 py-3.5 text-base font-semibold text-pine-800 transition-colors hover:bg-mist-100"
          >
            <Icon name="phone" size={17} />
            {site.contact.phone}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Who it's for + challenges -->
  <section class="bg-white">
    <div class="container-site grid gap-12 py-16 sm:py-20 lg:grid-cols-2">
      <div data-reveal>
        <h2 class="text-2xl sm:text-3xl">Who this is for</h2>
        <ul class="mt-6 space-y-3.5">
          {
            data.whoFor.map((item) => (
              <li class="flex items-start gap-3 text-[1.02rem] text-ink-700">
                <span class="mt-1 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-mist-100 text-pine-700">
                  <Icon name="check" size={13} />
                </span>
                {item}
              </li>
            ))
          }
        </ul>
      </div>
      <div data-reveal style="--reveal-delay: 120ms">
        <h2 class="text-2xl sm:text-3xl">The usual sticking points</h2>
        <div class="mt-6 space-y-4">
          {
            data.challenges.map((c) => (
              <div class="rounded-xl border border-line-100 bg-mist-50 p-5">
                <h3 class="font-bold text-ink-950">{c.title}</h3>
                <p class="mt-1 text-[0.95rem] leading-relaxed text-ink-600">{c.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- How we help -->
  <section class="bg-pine-950 bg-texture-dark on-dark">
    <div class="container-site py-16 sm:py-20">
      <SectionHeader eyebrow="How Influx helps" heading="What we actually do about it" dark />
      <div class="mt-10 grid gap-5 md:grid-cols-3">
        {
          data.howWeHelp.map((h, i) => (
            <div
              class="rounded-2xl border border-white/10 bg-white/5 p-6"
              data-reveal
              style={`--reveal-delay: ${i * 70}ms`}
            >
              <h3 class="text-lg font-bold text-white">{h.title}</h3>
              <p class="mt-2 text-[0.95rem] leading-relaxed text-sage-200">{h.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="bg-white">
    <div class="container-site grid gap-12 py-16 sm:py-20 lg:grid-cols-[0.85fr_1.15fr]">
      <div>
        <SectionHeader
          eyebrow="Step by step"
          heading="How the process runs"
          lede="You'll know what's happening at every stage, this is the map."
        />
      </div>
      <ProcessSteps steps={data.process} />
    </div>
  </section>

  <!-- Considerations -->
  <section class="bg-mist-50">
    <div class="container-site py-16 sm:py-20">
      <SectionHeader eyebrow="Worth knowing" heading="Key considerations before you start" />
      <ul class="mt-8 grid gap-4 md:grid-cols-2">
        {
          data.considerations.map((c, i) => (
            <li
              class="flex items-start gap-3 rounded-xl border border-line-100 bg-white p-5 text-[0.98rem] text-ink-700"
              data-reveal
              style={`--reveal-delay: ${i * 50}ms`}
            >
              <Icon name="scale" size={19} class="mt-0.5 shrink-0 text-pine-700" />
              {c}
            </li>
          ))
        }
      </ul>
      <p class="mt-8 max-w-3xl text-[0.82rem] leading-relaxed text-ink-500">
        {generalAdviceDisclaimer}
      </p>
    </div>
  </section>

  <!-- FAQs + team member -->
  <section class="bg-white">
    <div class="container-site grid gap-12 py-16 sm:py-20 lg:grid-cols-[1.2fr_0.8fr]">
      <div>
        <SectionHeader eyebrow="FAQs" heading={`${data.title} questions, answered`} />
        <div class="mt-8" data-reveal>
          <FAQAccordion items={data.faqs} />
        </div>
      </div>
      {
        teamMember && (
          <div>
            <SectionHeader eyebrow="Your specialist" heading="Who you'll be working with" />
            <div class="mt-8 max-w-sm">
              <TeamCard
                name={teamMember.data.name}
                role={teamMember.data.role}
                image={teamMember.data.image}
                imageAlt={teamMember.data.imageAlt}
                focus={teamMember.data.focus}
              />
            </div>
          </div>
        )
      }
    </div>
  </section>

  <!-- Related content -->
  {
    (relatedServices.length > 0 || relatedArticles.length > 0) && (
      <section class="bg-mist-50">
        <div class="container-site py-16 sm:py-20">
          {relatedServices.length > 0 && (
            <>
              <SectionHeader eyebrow="Related services" heading="Also worth a look" />
              <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
                {relatedServices.map((rel, i) => (
                  <ServiceCard
                    title={rel.data.navLabel}
                    description={rel.data.metaDescription.split('.')[0] + '.'}
                    href={`/services/${rel.id}`}
                    icon={rel.data.icon}
                    delay={i * 60}
                  />
                ))}
              </div>
            </>
          )}
          {relatedArticles.length > 0 && (
            <>
              <h2 class="mt-14 text-2xl font-bold">Helpful reading</h2>
              <div class="mt-6 grid gap-5 md:grid-cols-3">
                {relatedArticles.map((article, i) => (
                  <ArticleCard
                    title={article.data.title}
                    description={article.data.description}
                    href={`/resources/${article.id}`}
                    category={article.data.category}
                    publishDate={article.data.publishDate}
                    delay={i * 60}
                  />
                ))}
              </div>
            </>
          )}
        </div>
      </section>
    )
  }

  <ConsultationCTA heading={data.ctaHeading} body={data.ctaBody} />
</BaseLayout>
