---
/** Shared layout for legal/compliance pages. */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/navigation/Breadcrumbs.astro';
import { formatDate } from '@/utils/format';

interface Props {
  title: string;
  description: string;
  heading: string;
  path: string;
  lastUpdated: Date;
}
const { title, description, heading, path, lastUpdated } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <section class="bg-mist-50 bg-texture">
    <div class="container-site max-w-4xl py-12 sm:py-14">
      <Breadcrumbs items={[{ name: heading, href: path }]} class="mb-6 text-ink-500" />
      <h1 class="text-3xl sm:text-4xl">{heading}</h1>
      <p class="mt-3 text-[0.9rem] text-ink-500">
        Last updated: <time datetime={lastUpdated.toISOString()}>{formatDate(lastUpdated)}</time>
      </p>
    </div>
  </section>
  <section class="bg-white">
    <div
      class="container-site max-w-3xl py-12 leading-[1.8] sm:py-14
      [&_a]:font-semibold [&_a]:text-pine-800 [&_a]:underline [&_a]:underline-offset-2
      [&_h2]:mb-3 [&_h2]:mt-9 [&_h2]:text-xl [&_h2]:font-bold
      [&_h3]:mb-2 [&_h3]:mt-6 [&_h3]:text-lg [&_h3]:font-bold
      [&_li]:mb-1.5 [&_ol]:mb-4 [&_ol]:list-decimal [&_ol]:pl-6
      [&_p]:mb-4 [&_ul]:mb-4 [&_ul]:list-disc [&_ul]:pl-6"
    >
      <slot />
    </div>
  </section>
</BaseLayout>
